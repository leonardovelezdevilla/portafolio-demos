---
import Icon from './Icon.astro';
import { NEGOCIO } from '../lib/negocio';
import { GRUPOS } from '../data/horarios';
import { PRECIOS, soles } from '../data/precios';
const escalera = [
  { n: 'A1', t: 'Hello, I’m Ana.' },
  { n: 'A2', t: 'Last weekend I visited my aunt.' },
  { n: 'B1', t: 'If I could, I would travel more.' },
  { n: 'B2', t: 'I’d rather we postponed the meeting.' },
  { n: 'C1', t: 'Had I known, I would have said so.' },
];
const desde = Math.min(...Object.values(PRECIOS).map((p) => p.ciclo));
---

<section class="hero" aria-labelledby="hero-tit">
  <div class="contenedor hero__arriba">
    <h1 id="hero-tit">Inglés que se <em>habla</em> desde la primera clase.</h1>
    <div class="hero__lado">
      <p class="hero__dato">Academia en {NEGOCIO.distrito}: {GRUPOS.length} grupos de A1 a C1, ciclos de 8 semanas desde {soles(desde)}, IGV incluido <span class="hero__demo">(precio ficticio)</span>.</p>
      <div class="hero__acciones">
        <a class="btn btn--coral" href="/#test">Hacer el test de nivel <Icon name="arrow-right" /></a>
        <a class="btn btn--claro" href="/#horarios">Ver horarios</a>
      </div>
      <p class="hero__nota">El test dura unos 5 minutos y no pide datos personales.</p>
    </div>
  </div>
  <div class="contenedor">
    <ol class="escalera" aria-label="Ejemplos de frases por nivel, de A1 a C1">
      {escalera.map((e) => (
        <li class={`peldano peldano--${e.n}`}>
          <span class="peldano__nivel">{e.n}</span>
          <span class="peldano__frase" lang="en">{e.t}</span>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .hero { background: #0a1230; color: #e9edf8; min-height: calc(100svh - 6.3rem); display: flex; flex-direction: column; justify-content: space-between; gap: 2rem; padding-top: clamp(2rem, 5vw, 3.5rem); overflow: hidden; }
  .hero h1 { color: #fff; font-size: clamp(2.7rem, 6.4vw, 5.6rem); line-height: 1.02; margin: 0; max-width: 14ch; }
  .hero h1 em { color: #ff9b85; }
  .hero__arriba { display: grid; gap: 1.5rem; align-items: end; }
  @media (min-width: 62rem) { .hero__arriba { grid-template-columns: 1.5fr 1fr; gap: 4rem; } }
  .hero__dato { font-size: 1.2rem; color: #d3daee; margin: 0 0 1.25rem; max-width: 30rem; }
  .hero__demo { font-size: 0.9rem; color: #b6c1de; }
  .hero__acciones { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .hero__nota { font-size: 0.95rem; color: #b6c1de; margin: 0.9rem 0 0; }
  .hero :global(.btn--claro) { background: transparent; color: #fff; border-color: #fff; }
  .hero :global(.btn--claro:hover) { background: rgb(255 255 255 / 0.14); border-color: #fff; color: #fff; }
  .hero :global(.btn:focus-visible) { outline-color: #fff; }

  .escalera { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; align-items: end; }
  .peldano { display: grid; grid-template-columns: auto 1fr; align-items: baseline; column-gap: 1rem; padding: 0.9rem 1.1rem; border-top: 1px solid rgb(255 255 255 / 0.2); background: #16264f; animation: sube 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) both; }
  .peldano__nivel { font: 600 clamp(2.4rem, 12vw, 4rem)/1 var(--serif); color: #fff; letter-spacing: -0.02em; }
  .peldano__frase { font: italic 400 1.15rem/1.3 var(--serif); color: #dfe6f5; }
  .peldano--A1 { background: #101c40; }
  .peldano--A2 { background: #16264f; margin-left: 0.75rem; animation-delay: 0.08s; }
  .peldano--B1 { background: #1d3b78; margin-left: 1.5rem; animation-delay: 0.16s; }
  .peldano--B2 { background: #2a4a92; margin-left: 2.25rem; animation-delay: 0.24s; }
  .peldano--C1 { background: var(--coral); margin-left: 3rem; animation-delay: 0.32s; }
  .peldano--C1 .peldano__frase { color: #fff; }
  .peldano--C1 .peldano__nivel { font-size: clamp(3.2rem, 16vw, 5.5rem); }
  @keyframes sube { from { transform: translateY(2rem); } to { transform: none; } }

  @media (min-width: 48rem) {
    .escalera { grid-template-columns: repeat(5, 1fr); }
    .peldano { grid-template-columns: 1fr; row-gap: 0.6rem; margin-left: 0 !important; padding: 1.1rem 1.1rem 1.3rem; border-top: 0; border-left: 1px solid rgb(255 255 255 / 0.12); align-content: start; }
    .peldano__nivel { font-size: clamp(3rem, 6.4vw, 6.5rem); }
    .peldano--C1 .peldano__nivel { font-size: clamp(3rem, 6.4vw, 6.5rem); }
    .peldano__frase { font-size: clamp(1rem, 1.5vw, 1.3rem); }
    .peldano--A1 { min-height: 9rem; }
    .peldano--A2 { min-height: 12.5rem; }
    .peldano--B1 { min-height: 16rem; }
    .peldano--B2 { min-height: 19.5rem; }
    .peldano--C1 { min-height: 23rem; }
  }
</style>
