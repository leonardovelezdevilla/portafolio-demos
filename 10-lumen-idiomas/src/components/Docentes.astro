---
import { Image } from 'astro:assets';
import { DOCENTES } from '../data/docentes';
import foto from '../assets/fotos/clase-profesor-pizarra.jpg';
---

<section class="docs" id="docentes" aria-labelledby="doc-tit">
  <div class="contenedor docs__fila">
    <div class="docs__foto">
      <Image src={foto} alt="Un profesor de pie frente a la pizarra explica a un salón de estudiantes sentados en mesas." widths={[480, 800, 1200]} sizes="(min-width: 62rem) 40vw, 100vw" format="webp" quality={70} loading="lazy" decoding="async" />
    </div>
    <div class="docs__cuerpo">
      <h2 id="doc-tit">Quién te <em>acompaña</em> en clase</h2>
      <p class="lead">Nombres y perfiles ficticios de demostración. Cada grupo muestra su docente en los horarios.</p>
      <ol class="roster">
        {DOCENTES.map((d) => (
          <li class="roster__fila">
            <h3 class="roster__nombre">{d.nombre} <span class="roster__ficticio">(ficticio)</span></h3>
            <p class="roster__enfoque">{d.enfoque}</p>
            <p class="roster__desc">{d.descripcion}</p>
          </li>
        ))}
      </ol>
      <p class="docs__nota">Perfiles ficticios: no se indican títulos ni certificaciones. Fotos de Unsplash (Brooke Cagle y Quilia), ilustrativas y sin relación con esta marca ficticia.</p>
    </div>
  </div>
</section>

<style>
  .docs { background: var(--blanco); padding-block: clamp(3rem, 8vw, 6rem); }
  .docs__fila { display: grid; gap: 2rem; align-items: start; }
  @media (min-width: 62rem) { .docs__fila { grid-template-columns: 0.8fr 1.4fr; gap: 4rem; } .docs__foto { position: sticky; top: 6rem; } }
  .docs__foto { overflow: hidden; border-radius: 4px; }
  .docs__foto :global(img) { width: 100%; height: clamp(14rem, 50vw, 34rem); object-fit: cover; object-position: 50% 40%; transition: transform 0.4s ease; }
  .docs__foto:hover :global(img) { transform: scale(1.02); }
  .roster { list-style: none; margin: 1.5rem 0 0; padding: 0; border-top: 2px solid var(--azul-900); }
  .roster__fila { display: grid; gap: 0.15rem 2rem; padding: 1.1rem 0; border-bottom: 1px solid var(--linea); }
  @media (min-width: 40rem) { .roster__fila { grid-template-columns: 1.2fr 1fr; align-items: baseline; } .roster__nombre { grid-row: span 2; } .roster__desc { grid-column: 2; } }
  .roster__nombre { font-size: clamp(1.7rem, 3.4vw, 2.4rem); margin: 0; line-height: 1.05; }
  .roster__ficticio { display: block; font: 400 0.85rem var(--sans); color: var(--tinta-suave); letter-spacing: 0; }
  .roster__enfoque { margin: 0; font-weight: 700; color: var(--coral-700); }
  .roster__desc { margin: 0; color: var(--tinta-suave); }
  .docs__nota { margin: 1.25rem 0 0; font-size: 0.92rem; color: var(--tinta-suave); }
  @media (prefers-reduced-motion: reduce) { .docs__foto :global(img) { transition: none; } .docs__foto:hover :global(img) { transform: none; } }
</style>
