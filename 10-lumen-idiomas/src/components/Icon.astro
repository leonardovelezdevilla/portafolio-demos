---
// Íconos Lucide (lucide-static, ISC) incrustados como SVG en línea.
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

interface Props {
  name: string;
  class?: string;
}
const { name, class: clase = 'icono' } = Astro.props;
const bruto = readFileSync(join(process.cwd(), 'node_modules/lucide-static/icons', `${name}.svg`), 'utf8');
const interior = bruto.replace(/<!--[\s\S]*?-->/, '').replace(/<svg[^>]*>/, '').replace('</svg>', '').trim();
const svg = `<svg xmlns="http://www.w3.org/2000/svg" class="${clase}" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">${interior}</svg>`;
---

<Fragment set:html={svg} />
