---
import Icon from './Icon.astro';
import { CICLO } from '../data/horarios';
import { CONDICIONES, IGV_TEXTO, PRECIOS, soles } from '../data/precios';

const planes = (['Presencial', 'Virtual'] as const).map((m) => ({
  m,
  ...PRECIOS[m],
  total: PRECIOS[m].ciclo + PRECIOS[m].materiales,
  icono: m === 'Virtual' ? 'monitor' : 'building-2',
  incluye:
    m === 'Virtual'
      ? ['24 horas de clase en vivo por videollamada', 'Práctica en plataforma durante el ciclo', 'Una entrevista de ubicación sin costo']
      : ['24 horas de clase en aulas de Pueblo Libre', 'Material de práctica en clase', 'Una entrevista de ubicación sin costo'],
}));
---

<section class="pre" id="precios" aria-labelledby="pre-tit">
  <div class="contenedor pre__cab">
    <h2 id="pre-tit">Un precio claro por <em>ciclo</em></h2>
    <p class="lead">{CICLO.nombre}: {CICLO.duracion}. El precio es el mismo para todos los niveles y horarios de la misma modalidad.</p>
  </div>

  <div class="pre__banda">
    {planes.map((p) => (
      <article class={`plan plan--${p.m}`}>
        <div class="plan__in">
          <h3><Icon name={p.icono} /> {p.m}</h3>
          <p class="plan__precio"><span>{soles(p.ciclo)}</span> por ciclo <small>IGV incluido</small></p>
          <ul class="plan__lista">
            {p.incluye.map((i) => <li><Icon name="check" /> {i}</li>)}
          </ul>
          <p class="plan__mat">Materiales aparte: {soles(p.materiales)} por ciclo ({p.materialesDetalle}), IGV incluido.</p>
          <p class="plan__total">Total del primer ciclo: <strong>{soles(p.total)}</strong></p>
        </div>
      </article>
    ))}
  </div>

  <div class="contenedor">
    <p class="precios__nota">{IGV_TEXTO}</p>
    <div class="condiciones" aria-labelledby="cond-tit">
      <h3 id="cond-tit">Condiciones del ciclo <span class="etiqueta-demo">Ficticias, de demo</span></h3>
      <dl>
        {CONDICIONES.map((c) => (
          <div><dt>{c.titulo}</dt><dd>{c.texto}</dd></div>
        ))}
      </dl>
    </div>
  </div>
</section>

<style>
  .pre { background: var(--papel); padding-block: clamp(3rem, 8vw, 6rem) clamp(3rem, 8vw, 5rem); }
  .pre__cab { margin-bottom: 2.25rem; }
  .pre__banda { display: grid; }
  .plan { padding: clamp(2rem, 5vw, 3.5rem) var(--gutter); color: #fff; }
  .plan--Presencial { background: var(--azul-900); }
  .plan--Virtual { background: var(--coral-700); }
  .plan__in { display: flex; flex-direction: column; gap: 0.6rem; max-width: 36rem; }
  @media (min-width: 52rem) {
    .pre__banda { grid-template-columns: 1fr 1fr; }
    .plan--Presencial { padding-left: max(var(--gutter), calc((100vw - var(--ancho)) / 2)); }
    .plan--Presencial .plan__in { margin-left: 0; }
    .plan--Virtual { padding-right: max(var(--gutter), calc((100vw - var(--ancho)) / 2)); }
    .plan--Virtual .plan__in { margin-left: 2rem; }
  }
  .plan h3 { display: flex; align-items: center; gap: 0.6rem; margin: 0; color: #fff; }
  .plan__precio { margin: 0; font-size: 1.05rem; color: #e9edf8; }
  .plan__precio span { display: block; font: 600 clamp(4.5rem, 12vw, 8rem)/0.95 var(--serif); letter-spacing: -0.03em; color: #fff; }
  .plan__precio small { display: inline-block; font-size: 0.85rem; font-weight: 700; color: #fff; border: 1px solid #fff; padding: 0.1rem 0.5rem; border-radius: 6px; margin-left: 0.3rem; }
  .plan__lista { list-style: none; margin: 0.5rem 0; padding: 0; display: grid; gap: 0.4rem; }
  .plan__lista li { display: flex; gap: 0.55rem; align-items: flex-start; }
  .plan__lista :global(.icono) { margin-top: 0.25rem; }
  .plan__mat { margin: 0; padding-top: 0.7rem; border-top: 1px solid rgb(255 255 255 / 0.4); font-size: 0.97rem; }
  .plan__total { margin: 0; }
  .precios__nota { margin: 1.5rem 0 2rem; font-size: 0.95rem; color: var(--tinta-suave); }
  .condiciones h3 { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem; margin-bottom: 1rem; }
  .condiciones dl { margin: 0; border-top: 2px solid var(--azul-900); }
  .condiciones dl > div { display: grid; gap: 0.2rem 2rem; padding: 0.9rem 0; border-bottom: 1px solid var(--linea); }
  @media (min-width: 52rem) { .condiciones dl > div { grid-template-columns: 14rem 1fr; } }
  .condiciones dt { font-weight: 700; color: var(--azul-900); }
  .condiciones dd { margin: 0; color: var(--tinta-suave); }
</style>
