---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import foto from '../assets/fotos/grupo-conversando-recorte.jpg';

const puntos = [
  { i: 'mic', t: 'Se habla desde el primer día', d: 'Cada clase reserva buena parte del tiempo para conversar, no solo para copiar de la pizarra.' },
  { i: 'users', t: 'Grupos por edad y nivel', d: 'Jóvenes de 12 a 17 y adultos estudian por separado, con ritmo y temas propios.' },
  { i: 'refresh-cw', t: 'Te reubicamos si hace falta', d: 'Si tras la entrevista o las primeras clases el nivel no encaja, se conversa un cambio de grupo.' },
];
---

<section class="metodo" aria-labelledby="met-tit">
  <div class="metodo__foto">
    <Image src={foto} alt="Tres personas ríen alrededor de una mesa de madera mientras conversan." widths={[640, 1024, 1600]} sizes="100vw" format="webp" quality={72} loading="lazy" decoding="async" />
  </div>
  <div class="contenedor metodo__marco">
    <div class="metodo__panel">
      <h2 id="met-tit">Cómo se estudia en <em>Lumen</em></h2>
      <ul class="metodo__lista">
        {puntos.map((p) => (
          <li><Icon name={p.i} /><div><h3>{p.t}</h3><p>{p.d}</p></div></li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .metodo { position: relative; background: var(--azul-900); }
  .metodo__foto { height: clamp(14rem, 45vw, 20rem); overflow: hidden; }
  .metodo__foto :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 62% 30%; }
  .metodo__panel { background: var(--azul-900); color: #e9edf8; padding: clamp(1.75rem, 5vw, 3rem) 0; }
  .metodo h2 { color: #fff; }
  .metodo h2 em { color: #ff9b85; }
  .metodo__lista { list-style: none; margin: 1.5rem 0 0; padding: 0; display: grid; gap: 1.5rem; }
  .metodo__lista li { display: flex; gap: 0.9rem; align-items: flex-start; }
  .metodo__lista :global(.icono) { width: 2.5rem; height: 2.5rem; padding: 0.55rem; background: var(--coral); border-radius: 50%; color: #fff; }
  .metodo__lista h3 { font-size: 1.35rem; margin-bottom: 0.25rem; color: #fff; }
  .metodo__lista p { margin: 0; color: #c9d2ea; }
  @media (min-width: 62rem) {
    .metodo { min-height: min(100svh, 46rem); }
    .metodo__foto { position: absolute; inset: 0; height: auto; }
    .metodo__marco { position: relative; min-height: min(100svh, 46rem); display: flex; align-items: flex-end; justify-content: flex-start; }
    .metodo__panel { width: min(100%, 38rem); padding: 2.5rem; }
  }
</style>
