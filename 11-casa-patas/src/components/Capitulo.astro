---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/** Un capítulo de «Una visita en Casa Patas»: foto grande + número, título, texto y un dato con enlace. */
interface Props {
  n: string;
  titulo: string;
  foto: ImageMetadata;
  alt: string;
  clase: 'a' | 'b' | 'c' | 'd';
  sizes: string;
  enlace: { href: string; texto: string };
}
const { n, titulo, foto, alt, clase, sizes, enlace } = Astro.props;
---
<article class={`cap cap--${clase}`}>
  <div class="cap__foto">
    <Image src={foto} alt={alt} widths={[480, 720, 960, 1280]} sizes={sizes} format="webp" quality={70} loading="lazy" decoding="async" />
  </div>
  <div class="cap__txt">
    <p class="cap__num" aria-hidden="true">{n}</p>
    <h3>{titulo}</h3>
    <slot />
    <p class="cap__dato"><a href={enlace.href}>{enlace.texto}</a></p>
  </div>
</article>
