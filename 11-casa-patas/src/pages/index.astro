---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import { FOTOS } from '../data/fotos';
import { HORARIO_TEXTO, NEGOCIO, PRECIOS, SERVICIOS_RESERVA, TAMANOS_BANO, TELEFONO_DEMO } from '../lib/config';
import { AVISO_REFERENCIAL } from '../lib/vacunas';

const soles = (n: number) => new Intl.NumberFormat('es-PE', { style: 'currency', currency: 'PEN', maximumFractionDigits: 0 }).format(n);
const wa = (t: string) => `https://wa.me/${TELEFONO_DEMO}?text=${encodeURIComponent(t)}`;
const waUrgencia = wa('Hola Casa Patas, tengo una urgencia con mi mascota (demo). Voy en camino.');
const waSinJs = wa('Hola Casa Patas, quiero reservar una cita (demo).');
const waConsulta = wa('Hola Casa Patas, quiero hacer una consulta (demo).');

const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'VeterinaryCare',
  name: 'Casa Patas (demo)',
  description: 'Veterinaria de barrio ficticia en Magdalena del Mar, Lima. Demo de portafolio de Vélez De Villa.',
  image: '/og.png',
  telephone: '+51900000000',
  address: { '@type': 'PostalAddress', streetAddress: 'Jr. Ejemplo 456 (ficticia)', addressLocality: 'Magdalena del Mar', addressRegion: 'Lima', addressCountry: 'PE' },
  areaServed: 'Magdalena del Mar, Lima',
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'], opens: '09:00', closes: '20:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Sunday', opens: '09:00', closes: '13:00' },
  ],
  priceRange: 'S/ (precios de ejemplo)',
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Servicios de Casa Patas (demo)',
    itemListElement: ['Consulta general', 'Vacunación y desparasitación', 'Baño y peluquería', 'Cirugías menores previa evaluación', 'Farmacia y alimento'].map((n) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: n } })),
  },
  currenciesAccepted: 'PEN',
  paymentAccepted: 'Efectivo, Yape, Plin, tarjeta',
}];

const faq = [
  { p: '¿Necesito cita para la consulta?', r: 'Consulta y vacunas: recomendamos reservar, pero también atendemos sin cita según disponibilidad. Baño y peluquería: solo con turno reservado. Las urgencias pasan primero y no se reservan.' },
  { p: '¿Qué llevo a la primera visita?', r: 'Si tienes el carnet de vacunas, tráelo. Si tu mascota toma algún medicamento, trae el envase o anota el nombre. Para el baño, avísanos si tiene pulgas, nudos o se pone nerviosa.' },
  { p: '¿Los precios incluyen IGV?', r: 'Sí, todos los precios «desde S/» incluyen IGV. El monto final lo confirma el médico o la groomer según el peso, el pelaje y lo que necesite tu mascota.' },
  { p: '¿Con cuánta anticipación reservo baño y peluquería?', r: 'Con 24 horas de anticipación y en los turnos de la groomer (9:00, 11:30, 14:00 y 16:30, de lunes a sábado). La consulta y la vacuna se reservan con 2 horas.' },
  { p: '¿Cómo pago?', r: 'Efectivo, Yape, Plin o tarjeta. Emitimos boleta o factura si nos das tu RUC. Si el comprobante supera S/ 700, pedimos tu DNI.' },
  { p: '¿Hacen cirugías?', r: 'Solo cirugías menores y siempre previa evaluación del médico: primero se examina a tu mascota y se explica el procedimiento, el costo final y los cuidados.' },
  { p: '¿Me pueden dar un diagnóstico por WhatsApp?', r: 'No. Por WhatsApp coordinamos citas y avisos. Un diagnóstico requiere examinar a tu mascota. Te pedimos no enviar detalles clínicos por ese medio.' },
  { p: '¿La guía de vacunas reemplaza al médico?', r: 'No. Es una referencia para que sepas qué suele corresponder según la edad. El médico define el esquema según el peso, la salud y las vacunas previas de tu mascota.' },
];
---
<Base
  titulo="Casa Patas | Veterinaria de barrio en Magdalena del Mar (demo)"
  descripcion="Casa Patas, veterinaria ficticia en Magdalena del Mar: consulta, vacunas, baño, farmacia y alimento. Reserva cita. Demo de portafolio."
  ruta="/"
  jsonLd={jsonLd}
>
  <section class="hero" aria-labelledby="hero-t">
    <div class="contenedor hero__grid">
      <div class="hero__texto">
        <p class="etiqueta">Veterinaria de barrio · Magdalena del Mar</p>
        <h1 id="hero-t">Cuidamos a tu mascota como parte de la familia.</h1>
        <p class="lead">Consulta con médico veterinario, vacunas con carnet, baño y peluquería con turnos propios, farmacia y alimento. Precios claros, en soles y con IGV incluido.</p>
        <div class="hero__acciones">
          <a class="btn btn--primario" href="#reserva"><Icono nombre="calendario" /> Reservar cita</a>
          <a class="btn btn--urgencia" href={waUrgencia} target="_blank" rel="noopener"><Icono nombre="mensaje" /> Urgencias por WhatsApp<span class="sr-only"> (se abre en una pestaña nueva)</span></a>
        </div>
        <div class="horario" role="group" aria-labelledby="horario-t">
          <p class="horario__t" id="horario-t"><Icono nombre="reloj" /> Horario de atención</p>
          <dl>
            {HORARIO_TEXTO.map((h) => <><dt>{h.dias}</dt><dd>{h.horas}</dd></>)}
          </dl>
          <p class="horario__ahora" data-ahora></p>
        </div>
      </div>
      <div>
        <div class="hero__foto">
          <Image src={FOTOS.hero} alt="Un médico veterinario con uniforme azul sostiene con cuidado a un perro pomerania y lo escucha con un estetoscopio." widths={[480, 720, 960]} sizes="(min-width: 900px) 44vw, calc(100vw - 32px)" format="webp" quality={72} loading="eager" fetchpriority="high" decoding="async" />
        </div>
        <p class="credito">Foto ilustrativa: Tima Miroshnichenko, Pexels.</p>
      </div>
    </div>
  </section>

  <section class="urgencias" id="urgencias" aria-labelledby="urg-t" tabindex="-1">
    <div class="contenedor">
      <p class="urgencias__horario" data-cerrado hidden><strong>Ahora estamos cerrados.</strong> Si es una urgencia, no esperes respuesta: acude a una clínica veterinaria con atención las 24 horas.</p>
      <p class="urgencias__horario"><strong>Horario de urgencias:</strong> lunes a sábado de 9:00 a 20:00 y domingos de 9:00 a 13:00. Fuera de ese horario, acude a una clínica veterinaria con atención las 24 horas.</p>
      <div class="urgencias__grid">
        <div>
          <p class="etiqueta">Urgencias</p>
          <h2 id="urg-t">Si es una urgencia, no esperes a reservar.</h2>
          <p>Avísanos por WhatsApp antes de salir y ven. Las urgencias pasan antes que las citas y no se reservan en esta web.</p>
          <div class="urgencias__acc">
                        <a class="btn" href={waUrgencia} data-wa-urgencia data-wa-cerrado={waConsulta} target="_blank" rel="noopener"><Icono nombre="mensaje" /> <span data-wa-texto>Avisar por WhatsApp</span><span class="sr-only"> (se abre en una pestaña nueva)</span></a>
          </div>
          <p class="urgencias__ref">{NEGOCIO.direccion}. Referencia: a media cuadra de un parque (ficticio). <a href="#como-llegar">Cómo llegar</a></p>
        </div>
        <div class="urgencias__col">
          <h3><Icono nombre="aviso" /> Cuándo ir de inmediato</h3>
          <ul>
            <li>Le cuesta respirar o tiene las encías pálidas o azuladas.</li>
            <li>Convulsiona, se desmaya o no reacciona.</li>
            <li>Un sangrado que no se detiene.</li>
            <li>Atropello, caída desde altura o golpe fuerte.</li>
            <li>Posible envenenamiento o ingesta de algo tóxico.</li>
            <li>No logra orinar o el abdomen está duro e hinchado.</li>
          </ul>
        </div>
        <div class="urgencias__col">
          <h3><Icono nombre="check" /> Qué hacer mientras llegas</h3>
          <ol>
            <li>Mantén la calma y llámanos antes de mover a tu mascota si puedes.</li>
            <li>Muévela lo mínimo y con apoyo firme (una tabla o una transportadora), sobre todo si hubo golpe o caída.</li>
            <li>No le des medicamentos humanos ni la fuerces a comer o beber.</li>
            <li>Si comió algo tóxico, lleva el envase.</li>
          </ol>
        </div>
      </div>
      <p class="urgencias__aviso">Por WhatsApp solo avisa que vas en camino: no damos diagnósticos ni enviamos tratamientos por chat, y te pedimos no mandar detalles clínicos.</p>
    </div>
  </section>

  <section class="seccion" id="servicios" aria-labelledby="serv-t">
    <div class="contenedor">
      <div class="encabezado">
        <p class="etiqueta">Servicios y precios</p>
        <h2 id="serv-t">Precios claros, desde el primer día.</h2>
        <p class="lead">Todos los montos son «desde» y llevan IGV incluido. El precio final lo confirma el médico o la groomer según el peso y lo que necesite tu mascota.</p>
      </div>
      <div class="servicios__grid">
        {PRECIOS.map((g) => (
          <section class="grupo" aria-labelledby={`g-${g.icono}`}>
            <h3 id={`g-${g.icono}`}><Icono nombre={g.icono} tamano={24} /> {g.grupo}</h3>
            <ul class="precios">
              {g.items.map((i) => (
                <li>
                  <span class="precios__n">{i.nombre}</span>
                  <span class="precio"><small>desde</small>{soles(i.desde)}</span>
                  <p class="precios__d">{i.detalle}</p>
                  {i.nota && <p class="precios__nota">{i.nota}</p>}
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
      <p class="servicios__pie">Precios de ejemplo de la demo, con IGV incluido. Las cirugías menores se programan solo previa evaluación del médico. Medicamentos de venta con receta se entregan únicamente con indicación médica.</p>
      <div class="servicios__fotos">
        <figure class="foto-card">
          <Image src={FOTOS.consultorio} alt="Un veterinario con uniforme celeste examina a un perro pastor alemán echado sobre la mesa de un consultorio." widths={[480, 720, 960]} sizes="(min-width: 768px) 50vw, calc(100vw - 32px)" format="webp" quality={72} loading="lazy" decoding="async" />
          <figcaption>Consultorio: examen físico con calma. Foto ilustrativa de Tima Miroshnichenko, Pexels.</figcaption>
        </figure>
        <figure class="foto-card">
          <Image src={FOTOS.peluqueria} alt="Una groomer seca con una manguera de aire a un perro yorkshire sobre la mesa de peluquería, con fondo azul." widths={[480, 720, 960]} sizes="(min-width: 768px) 50vw, calc(100vw - 32px)" format="webp" quality={66} loading="lazy" decoding="async" class="foto--peluqueria" />
          <figcaption>Baño y peluquería con turnos propios. Foto ilustrativa de Tima Miroshnichenko, Pexels.</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="seccion seccion--salvia" id="guia-vacunas" aria-labelledby="guia-t">
    <div class="contenedor">
      <div class="encabezado">
        <p class="etiqueta">Guía referencial</p>
        <h2 id="guia-t">Vacunas y desparasitación: ¿qué suele corresponder?</h2>
        <p class="lead">Elige la especie y la edad de tu mascota para ver un calendario orientativo.</p>
      </div>
      <p class="aviso aviso--corto" role="note"><strong>Referencia orientativa:</strong> el médico define el esquema según tu mascota.</p>
      <div class="dos-col">
        <form class="panel" novalidate data-form-guia aria-labelledby="guia-form-t">
          <h3 id="guia-form-t">Datos de tu mascota</h3>
          <div class="error error--resumen" data-resumen-errores hidden></div>
          <fieldset class="campo" aria-describedby="g-especie-e">
            <legend>Especie</legend>
            <div class="opciones opciones--fila">
              <label class="opcion"><input type="radio" name="especie" value="perro" required /><span><b>Perro</b></span></label>
              <label class="opcion"><input type="radio" name="especie" value="gato" /><span><b>Gato</b></span></label>
            </div>
            <p class="error" id="g-especie-e" data-error="especie" hidden></p>
          </fieldset>
          <fieldset class="campo">
            <legend>¿Qué dato tienes?</legend>
            <div class="opciones-simple">
              <label><input type="radio" name="modo" value="edad" checked /> Solo sé la edad</label>
              <label><input type="radio" name="modo" value="nacimiento" /> Sé la fecha de nacimiento</label>
            </div>
          </fieldset>
          <div data-modo="edad">
            <div class="fila">
              <div class="campo">
                <label for="g-edad">Edad aproximada</label>
                <input id="g-edad" name="edadValor" type="number" inputmode="numeric" min="1" max="300" step="1" aria-describedby="g-edad-a g-edad-e" />
                <p class="campo__ayuda" id="g-edad-a">Si dudas, pon una edad aproximada; por ejemplo, 8 semanas o 5 meses.</p>
                <p class="error" id="g-edad-e" data-error="edadValor" hidden></p>
              </div>
              <div class="campo">
                <label for="g-unidad">Unidad</label>
                <select id="g-unidad" name="edadUnidad" aria-describedby="g-unidad-e">
                  <option value="semanas">Semanas</option>
                  <option value="meses" selected>Meses</option>
                  <option value="anios">Años</option>
                </select>
                <p class="error" id="g-unidad-e" data-error="edadUnidad" hidden></p>
              </div>
            </div>
          </div>
          <div data-modo="nacimiento" hidden>
            <div class="campo">
              <label for="g-nac">Fecha de nacimiento</label>
              <input id="g-nac" name="nacimiento" type="date" aria-describedby="g-nac-e" />
              <p class="error" id="g-nac-e" data-error="nacimiento" hidden></p>
            </div>
          </div>
          <button type="submit" class="btn btn--primario">Ver guía referencial</button>
          <noscript><p class="nota">Esta guía necesita JavaScript. Sin él, consulta el esquema con el médico: <a href={waSinJs} target="_blank" rel="noopener">escríbenos por WhatsApp</a>.</p></noscript>
        </form>
        <div>
          <div class="panel guia-res" data-resultado role="region" tabindex="-1" aria-labelledby="guia-res-t" hidden>
            <h3 id="guia-res-t" data-res-titulo>Guía referencial</h3>
            <div class="aviso aviso--grande" role="note"><strong>Esto es solo una referencia.</strong>{AVISO_REFERENCIAL} Las edades siguen la práctica común en Lima y el médico puede variar el esquema.</div>
            <ul class="guia-res__resumen" data-res-resumen></ul>
            <div class="acciones acciones--guia">
              <a class="btn btn--primario" href="#reserva" data-elegir-servicio="vacuna"><Icono nombre="jeringa" /> Reservar vacunación</a>
              <a class="btn" href="#reserva" data-elegir-servicio="consulta">Pedir consulta</a>
            </div>
            <div data-res-lista></div>
            <p class="nota" data-res-avisos></p>
          </div>
          <div class="lateral-foto" data-guia-foto>
            <Image src={FOTOS.vacuna} alt="Manos con guantes preparan una jeringa mientras sostienen a un gato carey con una prenda azul sobre una mesa metálica." widths={[480, 720, 960]} sizes="(min-width: 960px) 44vw, calc(100vw - 32px)" format="webp" quality={66} loading="lazy" decoding="async" class="foto--vacuna" />
            <p class="credito">Foto ilustrativa: Gustavo Fring, Pexels.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="seccion" id="reserva" aria-labelledby="res-t">
    <div class="contenedor">
      <div class="encabezado">
        <p class="etiqueta">Reserva de cita</p>
        <h2 id="res-t">Reserva tu cita en pocos pasos.</h2>
        <p class="lead">Elige el servicio, cuéntanos de tu mascota y escoge el día y la hora. Termina en un mensaje de WhatsApp listo para enviar.</p>
      </div>
      <div class="dos-col dos-col--reserva">
        <div>
          <div class="aviso aviso--urgencia" role="note">
            <p><strong>Las urgencias no se reservan aquí.</strong> Si tu mascota está en riesgo, ve a <a href="#urgencias">Urgencias</a> y avísanos por WhatsApp.</p>
          </div>
          <form class="panel" novalidate data-form-reserva aria-labelledby="res-form-t">
            <h3 id="res-form-t">Datos de la cita</h3>
            <div class="error error--resumen" data-resumen-errores hidden></div>
            <p class="nota">Todos los campos son obligatorios, salvo el texto opcional.</p>

            <fieldset class="campo" aria-describedby="r-servicio-e">
              <legend>Servicio</legend>
              <div class="opciones opciones--3">
                {SERVICIOS_RESERVA.map((s) => (
                  <label class="opcion"><input type="radio" name="servicio" value={s.id} required /><span><b>{s.nombre}</b><span>{s.detalle}. Desde {soles(s.desde)}.</span></span></label>
                ))}
              </div>
              <p class="error" id="r-servicio-e" data-error="servicio" hidden></p>
            </fieldset>

            <div class="fila">
              <fieldset class="campo" aria-describedby="r-especie-e">
                <legend>Especie</legend>
                <div class="opciones opciones--fila">
                  <label class="opcion"><input type="radio" name="especie" value="perro" required /><span><b>Perro</b></span></label>
                  <label class="opcion"><input type="radio" name="especie" value="gato" /><span><b>Gato</b></span></label>
                </div>
                <p class="error" id="r-especie-e" data-error="especie" hidden></p>
              </fieldset>
              <div class="campo" data-bloque-tamano hidden>
                <label for="r-tamano">Tamaño (para baño y peluquería)</label>
                <select id="r-tamano" name="tamano" aria-describedby="r-tamano-e" required>
                  <option value="">Elige el tamaño</option>
                  {TAMANOS_BANO.map((t) => <option value={t.id}>{t.nombre}, desde {soles(t.desde)}</option>)}
                </select>
                <p class="error" id="r-tamano-e" data-error="tamano" hidden></p>
              </div>
            </div>

            <div class="fila">
              <div class="campo">
                <label for="r-mascota">Nombre de la mascota</label>
                <input id="r-mascota" name="mascota" type="text" autocomplete="off" maxlength="30" aria-describedby="r-mascota-e" required />
                <p class="error" id="r-mascota-e" data-error="mascota" hidden></p>
              </div>
              <div class="fila fila--edad">
                <div class="campo">
                  <label for="r-edad">Edad aproximada</label>
                  <input id="r-edad" name="edadValor" type="number" inputmode="numeric" min="1" max="35" step="1" aria-describedby="r-edad-a r-edad-e" required />
                  <p class="campo__ayuda" id="r-edad-a">Aproximada; ej. 8 semanas.</p>
                </div>
                <div class="campo">
                  <label for="r-unidad">Unidad</label>
                  <select id="r-unidad" name="edadUnidad">
                    <option value="semanas">Semanas</option>
                    <option value="meses">Meses</option>
                    <option value="anios" selected>Años</option>
                  </select>
                </div>
                <p class="error error--edad" id="r-edad-e" data-error="edadValor" hidden></p>
              </div>
            </div>

            <div class="fila">
              <div class="campo">
                <label for="r-dueno">Tu nombre</label>
                <input id="r-dueno" name="dueno" type="text" autocomplete="name" aria-describedby="r-dueno-e" required />
                <p class="error" id="r-dueno-e" data-error="dueno" hidden></p>
              </div>
              <div class="campo">
                <label for="r-cel">Celular</label>
                <input id="r-cel" name="celular" type="tel" inputmode="tel" autocomplete="tel" aria-describedby="r-cel-a r-cel-e" required />
                <p class="campo__ayuda" id="r-cel-a">9 dígitos, empieza con 9. Ejemplo: 987 654 321.</p>
                <p class="error" id="r-cel-e" data-error="celular" hidden></p>
              </div>
            </div>

            <div class="fila">
              <div class="campo">
                <label for="r-fecha">Fecha</label>
                <input id="r-fecha" name="fecha" type="date" aria-describedby="r-fecha-a r-fecha-e" required />
                <p class="campo__ayuda" id="r-fecha-a">Atendemos lun a sáb de 9:00 a 20:00 y dom de 9:00 a 13:00 (hora de Lima). Baño y peluquería: lun a sáb.</p>
                <p class="error" id="r-fecha-e" data-error="fecha" hidden></p>
              </div>
              <div class="campo">
                <label for="r-hora">Hora o turno</label>
                <select id="r-hora" name="hora" aria-describedby="r-hora-a r-hora-e" required>
                  <option value="">Elige primero servicio y fecha</option>
                </select>
                <p class="campo__ayuda" id="r-hora-a" data-ayuda-hora>Las horas no disponibles aparecen marcadas como «no disponible».</p>
                <p class="error" id="r-hora-e" data-error="hora" hidden></p>
              </div>
            </div>

            <div class="campo">
              <label for="r-sintomas">¿Algo que quieras comentar al médico? (opcional)</label>
              <p class="campo__ayuda" id="r-sintomas-a"><strong>No envíes detalles clínicos por WhatsApp.</strong> Este texto solo se muestra en tu confirmación y no se incluye en el mensaje. Cuéntalo en la consulta. Máximo 200 caracteres.</p>
              <textarea id="r-sintomas" name="sintomas" maxlength="220" aria-describedby="r-sintomas-a r-sintomas-e"></textarea>
              <p class="error" id="r-sintomas-e" data-error="sintomas" hidden></p>
            </div>

            <div class="campo">
              <label class="check">
                <input type="checkbox" name="acepta" value="si" aria-describedby="r-acepta-a r-acepta-e" />
                <span>Acepto que Casa Patas use el nombre de mi mascota, mi nombre y mi celular para gestionar esta cita y confirmarla. Lee la <a href="/privacidad/">Política de privacidad</a>.</span>
              </label>
              <p class="campo__ayuda" id="r-acepta-a"><Icono nombre="info" tamano={16} /> Al abrir WhatsApp, tu mensaje y tu número pasan a WhatsApp (Meta).</p>
              <p class="error" id="r-acepta-e" data-error="acepta" hidden></p>
            </div>

            <button type="submit" class="btn btn--primario">Preparar mensaje de cita</button>
            <noscript><p class="nota">La reserva necesita JavaScript. Sin él, <a href={waSinJs} target="_blank" rel="noopener">escríbenos por WhatsApp</a> para coordinar tu cita.</p></noscript>
          </form>

          <section class="panel cita-ok" data-cita-ok role="region" tabindex="-1" aria-labelledby="cita-ok-t" hidden>
            <p class="etiqueta">Confirmación de demo</p>
            <h3 id="cita-ok-t">Falta un paso: envía tu solicitud por WhatsApp</h3>
            <p>Código de tu solicitud (demo): <strong data-numero></strong>. <strong>Todavía no hay cita:</strong> esta es una demo y no se guardó ningún dato. Para solicitarla a la clínica, abre WhatsApp con el mensaje ya redactado y envíalo.</p>
            <dl class="resumen" data-resumen></dl>
            <div class="aviso" role="note"><p>Al abrir WhatsApp, tu mensaje y tu número pasan a WhatsApp (Meta). El mensaje no incluye lo que escribiste para el médico ni el celular.</p></div>
            <div class="acciones">
              <a class="btn btn--primario" data-wa href="https://wa.me/51935852637" target="_blank" rel="noopener"><Icono nombre="mensaje" /> Enviar solicitud por WhatsApp<span class="sr-only"> (se abre en una pestaña nueva)</span></a>
              <button type="button" class="btn" data-nueva>Hacer otra reserva</button>
            </div>
          </section>
        </div>

        <aside>
          <h3>Antes de tu visita</h3>
          <ul class="datos">
            <li><Icono nombre="reloj" /> <span><strong>Consulta y vacuna:</strong> citas cada 30 minutos, con 2 horas de anticipación.</span></li>
            <li><Icono nombre="banio" /> <span><strong>Baño y peluquería:</strong> turnos propios a las 9:00, 11:30, 14:00 y 16:30, de lunes a sábado, con 24 horas de anticipación.</span></li>
            <li><Icono nombre="escudo" /> <span><strong>Trae el carnet</strong> de vacunas si lo tienes.</span></li>
            <li><Icono nombre="calendario" /> <span>Revisa la <a href="#politica">política de citas</a> para tolerancia y reprogramación.</span></li>
          </ul>
          <div class="lateral-foto">
            <Image src={FOTOS.convivencia} alt="Un perro grande de pelo claro baja la cabeza para olfatear a un gatito gris sentado sobre un piso de madera." widths={[480, 720, 960]} sizes="(min-width: 960px) 36vw, calc(100vw - 32px)" format="webp" quality={62} loading="lazy" decoding="async" class="foto--conv" />
            <p class="credito">Foto ilustrativa: belen capello, Pexels.</p>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="seccion seccion--papel" id="equipo" aria-labelledby="eq-t">
    <div class="contenedor">
      <div class="encabezado">
        <p class="etiqueta">Equipo (ficticio)</p>
        <h2 id="eq-t">Las personas que cuidan a tu mascota.</h2>
        <p class="lead">Nombres ficticios; cualquier parecido con personas reales es coincidencia. En una clínica real, la colegiatura del médico se muestra en el consultorio.</p>
      </div>
      <div class="equipo">
        <article class="persona">
          <h3>Camila Arévalo</h3>
          <p class="persona__rol">Médica veterinaria, medicina general y felina</p>
          <p>Consultas, vacunación y seguimiento de gatitos y cachorros. Explica cada paso con calma a quien acompaña.</p>
          <p class="persona__cmvp">CMVP visible en la clínica.</p>
        </article>
        <article class="persona">
          <h3>Mateo Salinas</h3>
          <p class="persona__rol">Médico veterinario, cirugía menor y medicina interna</p>
          <p>Evalúa a cada paciente antes de proponer un procedimiento y detalla cuidados y costos con anticipación.</p>
          <p class="persona__cmvp">CMVP visible en la clínica.</p>
        </article>
        <article class="persona">
          <h3>Lucía Ortega</h3>
          <p class="persona__rol">Groomer, baño y peluquería</p>
          <p>Trabaja con turnos propios para no apurar a ninguna mascota y revisa piel y pelaje antes de empezar.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="seccion" id="politica" aria-labelledby="pol-t">
    <div class="contenedor">
      <div class="encabezado">
        <p class="etiqueta">Política de citas</p>
        <h2 id="pol-t">Tolerancia, reprogramación y cancelación.</h2>
        <p class="nota">Política de ejemplo para esta demo; en un negocio real debe validarse con asesoría legal.</p>
      </div>
      <dl class="politica">
        <div><dt><Icono nombre="reloj" /> Tolerancia</dt><dd>15 minutos para consulta y vacuna, y 10 minutos para baño y peluquería. Pasado ese tiempo, reprogramamos según disponibilidad. Si una urgencia retrasa tu cita, te avisamos por WhatsApp.</dd></div>
        <div><dt><Icono nombre="calendario" /> Reprogramación</dt><dd>Sin costo hasta 4 horas antes en consulta y vacuna, y hasta 24 horas antes en baño y peluquería. Escríbenos por WhatsApp indicando el código de tu solicitud.</dd></div>
        <div><dt><Icono nombre="cerrar" /> Cancelación y ausencias</dt><dd>No se cobra penalidad por cancelar tarde ni por no asistir. Si no llegas y no avisas dos veces seguidas, solo te pediremos confirmar tu siguiente cita con un mensaje.</dd></div>
        <div><dt><Icono nombre="banio" /> Baño y peluquería</dt><dd>Avísanos si tu mascota tiene pulgas, nudos fuertes o se estresa: puede aplicarse un recargo, que te informamos y debes aceptar antes de empezar. Registramos su estado al recibirla.</dd></div>
        <div><dt><Icono nombre="jeringa" /> Vacunas</dt><dd>Trae el carnet. El médico examina a tu mascota antes de vacunar y puede posponer la dosis si no está en condiciones.</dd></div>
        <div><dt><Icono nombre="sirena" /> Urgencias</dt><dd>Pasan primero y no se reservan. Si estás en una cita y llega una urgencia, podemos demorar unos minutos tu atención.</dd></div>
      </dl>
    </div>
  </section>

  <section class="seccion" id="como-llegar" aria-labelledby="ub-t">
    <div class="contenedor">
      <div class="encabezado">
        <p class="etiqueta">Ubicación (ficticia)</p>
        <h2 id="ub-t">Estamos en Magdalena del Mar.</h2>
      </div>
      <div class="ubicacion">
        <div>
          <ul class="datos">
            <li><Icono nombre="pin" /> <span>{NEGOCIO.direccion}. Referencia: a media cuadra de un parque (ficticio).</span></li>
            <li><Icono nombre="reloj" /> <span>Lunes a sábado, 9:00 a 20:00. Domingo, 9:00 a 13:00.</span></li>
            <li><Icono nombre="mensaje" /> <span>WhatsApp: en esta demo, el mensaje llega a Vélez De Villa.</span></li>
          </ul>
          <p class="nota">La dirección y el teléfono son ficticios. Esta demo no incluye un mapa interactivo para no cargar servicios de terceros.</p>
          <a class="btn" href="#reserva">Reservar una cita</a>
        </div>
        <div class="mapa" role="img" aria-label="Ilustración del mapa: la dirección de la clínica es ficticia">
          <div><Icono nombre="pin" tamano={48} /><p><strong>Magdalena del Mar, Lima</strong><br />Dirección ficticia de demo</p></div>
        </div>
      </div>
    </div>
  </section>

  <section class="seccion seccion--papel" id="preguntas" aria-labelledby="faq-t">
    <div class="contenedor">
      <div class="encabezado">
        <p class="etiqueta">Preguntas frecuentes</p>
        <h2 id="faq-t">Lo que más nos preguntan.</h2>
      </div>
      <div class="faq">
        {faq.map((f) => (
          <details>
            <summary>{f.p} <Icono nombre="abajo" /></summary>
            <div><p>{f.r}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <script>
    import '../scripts/horario';
    import '../scripts/guia';
    import '../scripts/reserva';
  </script>
</Base>
