---
import Base from '../layouts/Base.astro';
---
<Base titulo="Página no encontrada | Casa Patas (demo)" descripcion="La página que buscas no existe en esta demo de Casa Patas." ruta="/404/" sinCanonical>
  <section class="contenedor seccion">
    <p class="etiqueta">Error 404</p>
    <h1>No encontramos esta página.</h1>
    <p class="lead">Puede que el enlace esté mal escrito o que ya no exista. Vuelve al inicio para reservar una cita o ver la guía de vacunas.</p>
    <div class="acciones">
      <a class="btn btn--primario" href="/">Ir al inicio</a>
      <a class="btn" href="/#reserva">Reservar cita</a>
    </div>
  </section>
</Base>
