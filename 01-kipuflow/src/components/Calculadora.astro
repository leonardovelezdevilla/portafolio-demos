---
import Icon from './Icon.astro';
import { calcular, UIT_2026 } from '../lib/impuestos';
const inicial = { ingresoMensual: 6000, recibosPorMes: 2 };
const r = calcular(inicial);
const sol = new Intl.NumberFormat('es-PE', { style: 'currency', currency: 'PEN', maximumFractionDigits: 0 });
const pct = (n: number) => `${Math.round(n * 100)} %`;
---
<section class="seccion calc-sec" id="calculadora" aria-labelledby="t-calc">
  <div class="contenedor">
    <div class="cabecera-sec">
      <h2 id="t-calc">¿Cuánto te retienen y cuánto pagarías al año?</h2>
      <p class="lead">Calculadora referencial de renta de 4.ª categoría para recibos por honorarios. Mueve los números y mira la retención, la deducción y el tramo de la escala.</p>
    </div>

    <div class="calc">
      <form class="calc-form" id="calc-form" novalidate aria-describedby="calc-aviso">
        <div class="campo">
          <label for="ingreso">Ingresos brutos mensuales (S/)</label>
          <input id="ingreso" name="ingreso" type="number" inputmode="decimal" min="0" max="1000000" step="50" value={inicial.ingresoMensual} aria-describedby="ingreso-err" />
          <p class="err" id="ingreso-err" role="alert"></p>
        </div>
        <div class="campo">
          <label for="recibos">Recibos por honorarios al mes</label>
          <input id="recibos" name="recibos" type="number" inputmode="numeric" min="1" max="60" step="1" value={inicial.recibosPorMes} aria-describedby="recibos-ayuda recibos-err" />
          <p class="ayuda" id="recibos-ayuda">La retención se decide recibo por recibo, no por el total del mes.</p>
          <p class="err" id="recibos-err" role="alert"></p>
        </div>
        <div class="regla">
          <Icon name="info" size={20} />
          <p><strong>Retención de 8 %:</strong> si un agente de retención te paga un recibo que <em>supera</em> S/ 1,500, te descuenta el 8 %. Es un pago a cuenta de tu impuesto anual, no el impuesto final.</p>
        </div>
      </form>

      <div class="calc-res" id="calc-res">
        <p class="sr-only" role="status" id="calc-status"></p>
        <p class="obsoleto" id="calc-obsoleto" hidden>No se recalculó: corrige los valores marcados. Lo que ves abajo es el cálculo anterior.</p>
        <h3 class="sr-only">Resultado</h3>
        <p class="res-estado" data-out="estado">{r.seRetiene ? `Cada recibo de ${sol.format(r.montoPorRecibo)} supera S/ 1,500: te retienen 8 %.` : `Cada recibo de ${sol.format(r.montoPorRecibo)} no supera S/ 1,500: sin retención.`}</p>
        <div class="res-grande">
          <p class="res-etq" data-out="saldoEtq">{r.saldo > 0 ? 'Impuesto por pagar al regularizar' : r.saldo < 0 ? 'Saldo a favor estimado' : 'Sin saldo'}</p>
          <p class="res-valor num" data-out="saldo">{sol.format(Math.abs(r.saldo))}</p>
          <p class="res-estim">Estimación, no una devolución garantizada.</p>
        </div>
        <p class="aviso" id="calc-aviso"><Icon name="circle-alert" size={20} /><span>Cálculo referencial, no reemplaza la asesoría de un contador ni la información de <span translate="no">SUNAT</span>.</span></p>
        <dl class="res-lista">
          <div><dt>Ingreso anual</dt><dd class="num" data-out="ingresoAnual">{sol.format(r.ingresoAnual)}</dd></div>
          <div><dt>Deducción 20 % (tope 24 UIT)</dt><dd class="num" data-out="deduccion20">− {sol.format(r.deduccion20)}</dd></div>
          <div><dt>Deducción fija 7 UIT</dt><dd class="num" data-out="deduccionFija">− {sol.format(r.deduccionFija)}</dd></div>
          <div class="sub"><dt>Renta neta anual</dt><dd class="num" data-out="rentaNeta">{sol.format(r.rentaNeta)}</dd></div>
          <div><dt>Impuesto anual (escala)</dt><dd class="num" data-out="impuestoAnual">{sol.format(r.impuestoAnual)}</dd></div>
          <div><dt>Retenciones del año</dt><dd class="num" data-out="retencionAnual">− {sol.format(r.retencionAnual)}</dd></div>
          <div><dt>Retención por mes</dt><dd class="num" data-out="retencionMensual">{sol.format(r.retencionMensual)}</dd></div>
        </dl>
        <div class="tramos" tabindex="0" role="region" aria-labelledby="tramos-tit">
          <p class="tramos-tit" id="tramos-tit">Cómo cae tu renta neta en la escala <span class="desliza">Desliza para ver todo</span></p>
          <table>
            <caption class="sr-only">Tramos de la escala progresiva</caption>
            <thead><tr><th scope="col">Tramo (UIT)</th><th scope="col">Base</th><th scope="col">Tasa</th><th scope="col">Impuesto</th></tr></thead>
            <tbody data-out="tramos">
              {r.tramos.length === 0 && <tr><td colspan="4">Tu renta neta es S/ 0: no hay impuesto anual.</td></tr>}
              {r.tramos.map((t) => (
                <tr><th scope="row">{t.desde / UIT_2026} a {Number.isFinite(t.hasta) ? t.hasta / UIT_2026 : 'más'}</th><td class="num">{sol.format(t.base)}</td><td class="num">{pct(t.tasa)}</td><td class="num">{sol.format(t.impuesto)}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
        <ul class="nota">
          <li>UIT 2026 usada: S/ {UIT_2026.toLocaleString('es-PE')}.</li>
          <li>Escala: 8 % hasta 5 UIT, 14 % hasta 20, 17 % hasta 35, 20 % hasta 45 y 30 % por encima.</li>
          <li>Solo retiene un cliente que es agente de retención.</li>
          <li>No considera la suspensión de retenciones o pagos a cuenta (RS 000390-2025/SUNAT), los gastos por boletas (3 UIT) ni otras rentas.</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .calc-sec { background: var(--surf); border-block: 1px solid var(--linea); }
  .cabecera-sec h2 { max-width: 20ch; }
  .calc { display: grid; gap: 0; border: 1px solid var(--tinta); border-radius: 8px; background: var(--blanco); }
  .calc-form { padding: 1.6rem 1.3rem; display: grid; gap: 1.6rem; align-content: start; border-radius: 7px 7px 0 0; }
  .campo label { font-size: 1.05rem; }
  .campo input { font-family: var(--f-mono); font-size: 1.5rem; min-height: 64px; padding-inline: 1rem; }
  .regla { display: grid; grid-template-columns: auto 1fr; gap: .7rem; padding: 1rem; border-radius: var(--radio); background: var(--cobalto-claro); font-size: .95rem; }
  .regla svg { color: var(--cobalto); margin-top: 3px; }
  .calc-res { background: var(--tinta); color: #fff; padding: 1.6rem 1.3rem; display: grid; gap: 1.6rem; align-content: start; min-width: 0; border-radius: 0 0 7px 7px; }
  .res-estado { color: #c3cdd5; }
  .res-grande { border-top: 1px solid rgba(255,255,255,.4); padding-top: 1rem; container-type: inline-size; }
  .res-etq { font-weight: 500; color: #fff; }
  .res-valor { font-size: clamp(2.4rem, 13cqw, 9.5rem); font-weight: 500; line-height: .95; color: #b9bfff; margin-top: .6rem; letter-spacing: -.05em; white-space: nowrap; }
  .res-estim { color: #c3cdd5; font-size: .92rem; margin-top: .7rem; }
  .aviso { display: grid; grid-template-columns: auto 1fr; gap: .7rem; padding: .9rem 1rem; border-radius: var(--radio); background: #fff4d6; border: 1px solid #c99a1e; color: #4a3600; font-weight: 500; font-size: .95rem; }
  .aviso svg { margin-top: 3px; }
  .res-lista { margin: 0; display: grid; border-top: 1px solid rgba(255,255,255,.4); }
  .res-lista > div { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .2rem 1rem; padding: .75rem 0; border-bottom: 1px solid rgba(255,255,255,.18); }
  .res-lista dt { color: #c3cdd5; }
  .res-lista dd { white-space: nowrap; margin: 0; font-weight: 500; text-align: right; color: #fff; font-size: 1.05rem; }
  .res-lista .sub dt, .res-lista .sub dd { color: #b9bfff; font-weight: 600; }
  .tramos-tit { font: 600 1rem var(--f-texto); margin-bottom: .6rem; }
  .tramos { overflow-x: auto; background:
      linear-gradient(90deg, #14202a 30%, rgba(20,32,42,0)) left center / 36px 100% no-repeat local,
      linear-gradient(270deg, #14202a 30%, rgba(20,32,42,0)) right center / 36px 100% no-repeat local,
      linear-gradient(90deg, rgba(255,255,255,.28), rgba(255,255,255,0)) left center / 14px 100% no-repeat scroll,
      linear-gradient(270deg, rgba(255,255,255,.28), rgba(255,255,255,0)) right center / 14px 100% no-repeat scroll; }
  .desliza { color: #c3cdd5; font: 400 .82rem var(--f-texto); margin-left: .5rem; }
  @media (min-width: 640px) { .desliza { display: none; } }
  .tramos :global(td:first-child), .tramos :global(th[scope='row']) { white-space: nowrap; }
  table { width: 100%; border-collapse: collapse; font-size: .9rem; }
  .tramos :global(th), .tramos :global(td) { padding: .5rem .3rem; text-align: right; border-top: 1px solid rgba(255,255,255,.18); white-space: nowrap; }
  thead th { color: #c3cdd5; font-weight: 500; border-top: 0 !important; }
  .tramos :global(th:first-child) { text-align: left; font-weight: 500; }
  .tramos :global(td) { color: #fff; }
  .nota { color: #c3cdd5; font-size: .9rem; margin: 0; padding-left: 1.1rem; display: grid; gap: .3rem; }
  .calc-res :focus-visible { outline-color: #fff; }
  .obsoleto { color: #ffd0cc; font-weight: 600; padding: .7rem 1rem; border: 1px solid #ff9b94; border-radius: var(--radio); }
  .obsoleto[hidden] { display: none; }
  .calc-res.viejo .res-grande, .calc-res.viejo .res-lista, .calc-res.viejo .tramos { opacity: .45; }
  @media (min-width: 640px) { .res-lista { grid-template-columns: 1fr 1fr; column-gap: 2.5rem; } .res-lista .sub { grid-column: 1 / -1; } }
  @media (min-width: 960px) {
    .calc { grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); align-items: stretch; min-height: min(760px, calc(100svh - 12rem)); }
    .calc-form { padding: 2.6rem 2.4rem; gap: 2rem; position: sticky; top: 96px; align-self: start; border-radius: 7px 0 0 7px; }
    .calc-res { padding: 2.6rem 3rem; gap: 1.8rem; border-radius: 0 7px 7px 0; }
  }
</style>

<script>
  import { calcular, UIT_2026 } from '../lib/impuestos';
  const sol = new Intl.NumberFormat('es-PE', { style: 'currency', currency: 'PEN', maximumFractionDigits: 0 });
  const pct = (n: number) => `${Math.round(n * 100)} %`;
  const form = document.getElementById('calc-form') as HTMLFormElement | null;
  if (form) {
    const ingreso = form.elements.namedItem('ingreso') as HTMLInputElement;
    const recibos = form.elements.namedItem('recibos') as HTMLInputElement;
    const out = (k: string) => document.querySelector<HTMLElement>(`[data-out="${k}"]`)!;
    const setErr = (el: HTMLInputElement, msg: string) => {
      const p = document.getElementById(el.id + '-err')!;
      p.textContent = msg;
      el.setAttribute('aria-invalid', msg ? 'true' : 'false');
    };
    const status = document.getElementById('calc-status')!;
    const res = document.getElementById('calc-res')!;
    const obsoleto = document.getElementById('calc-obsoleto')!;
    let t: number | undefined;
    // Las cifras cuentan hasta su valor nuevo. Solo presentación: el cálculo ya salió de calcular().
    const sinMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)');
    const previo = new Map<string, number>();
    const marcos = new Map<string, number>();
    const cuenta = (k: string, destino: number, prefijo = '') => {
      const el = out(k);
      const desde = previo.get(k) ?? destino;
      previo.set(k, destino);
      window.cancelAnimationFrame(marcos.get(k) ?? 0);
      if (sinMovimiento.matches || desde === destino) { el.textContent = prefijo + sol.format(destino); return; }
      const ini = performance.now();
      const paso = (ahora: number) => {
        const p = Math.min(1, (ahora - ini) / 380);
        const e = 1 - Math.pow(1 - p, 3);
        el.textContent = prefijo + sol.format(p === 1 ? destino : Math.round(desde + (destino - desde) * e));
        if (p < 1) marcos.set(k, window.requestAnimationFrame(paso));
      };
      marcos.set(k, window.requestAnimationFrame(paso));
    };
    for (const k of ['saldo', 'ingresoAnual', 'deduccion20', 'deduccionFija', 'rentaNeta', 'impuestoAnual', 'retencionAnual', 'retencionMensual']) {
      const v = Number((out(k).textContent ?? '').replace(/\D/g, ''));
      if (Number.isFinite(v)) previo.set(k, v);
    }
    const actualizar = () => {
      const i = ingreso.value.trim() === '' ? NaN : Number(ingreso.value);
      const n = recibos.value.trim() === '' ? NaN : Number(recibos.value);
      let ok = true;
      if (!Number.isFinite(i) || i < 0 || i > 1_000_000) { setErr(ingreso, 'Escribe un monto mensual entre S/ 0 y S/ 1,000,000.'); ok = false; } else setErr(ingreso, '');
      if (!Number.isInteger(n) || n < 1 || n > 60) { setErr(recibos, 'Escribe un número entero de recibos entre 1 y 60.'); ok = false; } else setErr(recibos, '');
      obsoleto.hidden = ok;
      res.classList.toggle('viejo', !ok);
      if (!ok) { status.textContent = 'No se recalculó: hay valores no válidos.'; return; }
      const r = calcular({ ingresoMensual: i, recibosPorMes: n });
      const estadoTxt = r.seRetiene
        ? `Cada recibo de ${sol.format(r.montoPorRecibo)} supera S/ 1,500: te retienen 8 %.`
        : `Cada recibo de ${sol.format(r.montoPorRecibo)} no supera S/ 1,500: sin retención.`;
      const etqTxt = r.saldo > 0 ? 'Impuesto por pagar al regularizar' : r.saldo < 0 ? 'Saldo a favor estimado' : 'Sin saldo';
      out('estado').textContent = estadoTxt;
      out('saldoEtq').textContent = etqTxt;
      cuenta('saldo', Math.abs(r.saldo));
      cuenta('ingresoAnual', r.ingresoAnual);
      cuenta('deduccion20', r.deduccion20, '− ');
      cuenta('deduccionFija', r.deduccionFija, '− ');
      cuenta('rentaNeta', r.rentaNeta);
      cuenta('impuestoAnual', r.impuestoAnual);
      cuenta('retencionAnual', r.retencionAnual, '− ');
      cuenta('retencionMensual', r.retencionMensual);
      window.clearTimeout(t);
      t = window.setTimeout(() => { status.textContent = `${etqTxt}: ${sol.format(Math.abs(r.saldo))}. ${estadoTxt}`; }, 400);
      const tb = out('tramos');
      tb.replaceChildren();
      if (r.tramos.length === 0) {
        const tr = tb.insertRow(); const td = tr.insertCell(); td.colSpan = 4; td.textContent = 'Tu renta neta es S/ 0: no hay impuesto anual.'; td.style.textAlign = 'left';
      }
      for (const t of r.tramos) {
        const tr = tb.insertRow();
        const th = document.createElement('th'); th.scope = 'row';
        th.textContent = `${t.desde / UIT_2026} a ${Number.isFinite(t.hasta) ? t.hasta / UIT_2026 : 'más'}`;
        tr.appendChild(th);
        for (const v of [sol.format(t.base), pct(t.tasa), sol.format(t.impuesto)]) { const td = tr.insertCell(); td.className = 'num'; td.textContent = v; }
      }
    };
    form.addEventListener('input', actualizar);
    form.addEventListener('submit', (e) => { e.preventDefault(); actualizar(); });
  }
</script>
