---
import Icon from './Icon.astro';
const planes = [['', 'Aún no lo sé'], ['esencial', 'Esencial'], ['pro', 'Pro'], ['estudio', 'Estudio']];
const profesiones = ['Diseñador/a', 'Desarrollador/a', 'Consultor/a', 'Redactor/a o traductor/a', 'Fotógrafo/a o videógrafo/a', 'Otra profesión'];
---
<section class="seccion acc-sec" id="acceso" aria-labelledby="t-acc">
  <div class="contenedor acc">
    <div>
      <h2 id="t-acc">Sé de los primeros en probar Kipuflow.</h2>
      <p class="lead">Déjanos tu nombre, correo y profesión. Nada se envía hasta que tú abras WhatsApp: al terminar verás una confirmación de ejemplo y un mensaje ya escrito que puedes enviar o descartar.</p>
      <ul class="recibes">
        <li>Una invitación cuando abra tu turno, sin tarjeta.</li>
        <li>La calculadora completa con tus propios recibos.</li>
        <li>Precio de lanzamiento de ejemplo en el plan que elijas.</li>
      </ul>
    </div>

    <div class="caja">
      <form id="acc-form" novalidate>
        <div class="campo">
          <label for="nombre">Nombre y apellido</label>
          <input id="nombre" name="nombre" type="text" autocomplete="name" aria-required="true" aria-describedby="nombre-err" />
          <p class="err" id="nombre-err" role="alert"></p>
        </div>
        <div class="campo">
          <label for="correo">Correo electrónico</label>
          <input id="correo" name="correo" type="email" autocomplete="email" inputmode="email" placeholder="nombre@ejemplo.invalid" aria-required="true" aria-describedby="correo-err" />
          <p class="err" id="correo-err" role="alert"></p>
        </div>
        <div class="campo">
          <label for="profesion">Profesión</label>
          <select id="profesion" name="profesion" aria-required="true" aria-describedby="profesion-err">
            <option value="">Elige una opción</option>
            {profesiones.map((p) => <option value={p}>{p}</option>)}
          </select>
          <p class="err" id="profesion-err" role="alert"></p>
        </div>
        <div class="campo">
          <label for="plan">Plan de interés (opcional)</label>
          <select id="plan" name="plan">
            {planes.map(([v, t]) => <option value={v}>{t}</option>)}
          </select>
        </div>
        <div class="campo check">
          <div class="check-fila">
            <input id="consent" name="consent" type="checkbox" aria-required="true" aria-describedby="consent-err" />
            <label for="consent">Acepto que Kipuflow (titular ficticio del banco de datos de esta demo) use mis datos solo para gestionar esta solicitud de acceso anticipado, según la <a href="/privacidad/">Privacidad</a>.</label>
          </div>
          <p class="err" id="consent-err" role="alert"></p>
        </div>
        <button class="btn btn-primario" type="submit">Solicitar acceso <Icon name="send" /></button>
        <p class="legal">No enviamos nada a ningún servidor. Si abres WhatsApp, tu mensaje se transmite a WhatsApp (Meta). Ver <a href="/terminos/">Términos de demo</a>.</p>
      </form>

      <div id="acc-ok" class="ok" hidden tabindex="-1" role="status" aria-labelledby="acc-ok-tit">
        <Icon name="shield-check" size={32} />
        <h3 id="acc-ok-tit">Listo, así se vería tu confirmación</h3>
        <p id="acc-ok-txt"></p>
        <a id="acc-wa" class="btn btn-primario" href="https://wa.me/51935852637" target="_blank" rel="noopener">Abrir WhatsApp con mi mensaje <span class="sr-only">(se abre en una pestaña nueva)</span></a>
        <button type="button" class="btn btn-sec" id="acc-volver">Corregir datos</button>
        <p class="legal">Número de demo. Es una confirmación simulada: no se guardó ni se envió nada.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .acc-sec { background: var(--surf); border-top: 1px solid var(--linea); }
  .acc { display: grid; gap: 2.5rem; align-items: start; }
  @media (min-width: 900px) { .acc { align-items: center; } }
  .acc h2 { max-width: 13ch; }
  .recibes { list-style: none; margin: 2rem 0 0; padding: 0; border-top: 1px solid var(--linea-fuerte); }
  .recibes li { padding: .9rem 0; border-bottom: 1px solid var(--linea); color: var(--tinta); }
  .caja { background: var(--blanco); border: 1px solid var(--tinta); border-radius: 8px; padding: 1.5rem; }
  form { display: grid; gap: 1.1rem; }
  form[hidden] { display: none; }
  .legal { color: var(--tinta-2); font-size: .9rem; }
  .check-fila { display: grid; grid-template-columns: auto 1fr; gap: .8rem; align-items: start; }
  .campo .check-fila input { width: 24px; min-height: 24px; height: 24px; margin-top: 2px; accent-color: var(--cobalto); }
  .check-fila label { font-weight: 400; color: var(--tinta-2); }
  .ok { display: grid; gap: 1rem; justify-items: start; }
  .ok svg { color: var(--cobalto); }
  .ok[hidden] { display: none; }
  @media (min-width: 900px) { .acc { grid-template-columns: 1fr 1fr; gap: 6rem; } .caja { padding: 2.2rem; } }
</style>

<script>
  const form = document.getElementById('acc-form') as HTMLFormElement | null;
  const ok = document.getElementById('acc-ok')!;
  if (form) {
    const campos = ['nombre', 'correo', 'profesion', 'consent'].map((id) => document.getElementById(id) as HTMLInputElement);
    const plan = document.getElementById('plan') as HTMLSelectElement;
    const pedido = new URLSearchParams(location.search).get('plan');
    if (pedido && [...plan.options].some((o) => o.value === pedido)) plan.value = pedido;
    const err = (el: HTMLInputElement, msg: string) => {
      document.getElementById(el.id + '-err')!.textContent = msg;
      el.setAttribute('aria-invalid', msg ? 'true' : 'false');
      return msg === '';
    };
    const validar = (el: HTMLInputElement) => {
      const v = el.value.trim();
      if (el.id === 'nombre') return err(el, v.length < 3 || !/\s/.test(v) ? 'Escribe tu nombre y apellido (mínimo 3 letras).' : '');
      if (el.id === 'correo') return err(el, !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v) ? 'Escribe un correo válido, por ejemplo nombre@dominio.pe.' : '');
      if (el.id === 'consent') return err(el, el.checked ? '' : 'Marca la casilla para aceptar el uso de tus datos.');
      return err(el, v === '' ? 'Elige tu profesión.' : '');
    };
    campos.forEach((c) => c.addEventListener('blur', () => validar(c)));
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const res = campos.map(validar);
      const primero = campos[res.indexOf(false)];
      if (primero) { primero.focus(); return; }
      const [n, c, p] = campos.map((x) => x.value.trim());
      const pl = plan.value ? ` Me interesa el plan ${plan.selectedOptions[0].text}.` : '';
      const msg = `Hola, soy ${n} (${p}). Quiero acceso anticipado a Kipuflow.${pl} Mi correo: ${c}`;
      (document.getElementById('acc-wa') as HTMLAnchorElement).href = `https://wa.me/51935852637?text=${encodeURIComponent(msg)}`;
      document.getElementById('acc-ok-txt')!.textContent = `Gracias, ${n.split(/\s+/)[0]}. Así se vería la respuesta a ${c}. Nada se ha enviado todavía.`;
      form.hidden = true;
      ok.hidden = false;
      ok.focus();
    });
    document.getElementById('acc-volver')!.addEventListener('click', () => { ok.hidden = true; form.hidden = false; campos[0].focus(); });
  }
</script>
