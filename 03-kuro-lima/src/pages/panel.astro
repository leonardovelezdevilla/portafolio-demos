---
import Base from '../layouts/Base.astro';
---
<Base titulo="Panel del restaurante · Kuro (demo)" descripcion="Demo del panel de Kuro: reservas de mesa y omakase, garantías y comprobantes de ejemplo, lista de espera, clientes y reporte del mes." ruta="/panel/">
  <div class="contenedor pagina">
    <p class="sobretitulo">Demo del sistema completo</p>
    <h1>Panel del restaurante</h1>
    <div class="aviso-demo">Así ve el restaurante las reservas que llegan desde la web: confirma, marca atendidas, cancela, envía recordatorios y revisa garantías pagadas. Todo sale de las reservas de prueba que hiciste en este navegador; pagos y comprobantes son simulados. Las alergias no se guardan aquí.</div>
    <div class="kit-panel" data-panel><p>Activa JavaScript para ver el panel de demostración.</p></div>
  </div>
</Base>
<script>
  import { panel } from '../kit/sistema-demo';
  import { iniciarKit } from '../lib/kit';
  iniciarKit();
  const raiz = document.querySelector<HTMLElement>('[data-panel]');
  if (raiz) panel(raiz);
</script>
