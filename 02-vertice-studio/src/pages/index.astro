---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import TarjetaProducto from '../components/TarjetaProducto.astro';
import VistaRapida from '../components/VistaRapida.astro';
import TablaTallas from '../components/TablaTallas.astro';
import { CATEGORIAS, TALLAS_EU, productos, porSlug } from '../data/productos';
import { foto } from '../data/fotos';
import { ENVIO, formatoSoles } from '../lib/carrito';

const hero = porSlug('musgo-knit')!;
const cuenta = (id: string) => productos.filter((p) => p.categoria === id).length;
const marquee = ['Pedidos por WhatsApp', 'Yape · Plin · Contraentrega en Lima', 'Tallas EU 36 a 45'];

const store = {
  '@context': 'https://schema.org',
  '@type': 'Store',
  name: 'Vértice Studio (demo)',
  description: 'Tienda ficticia de zapatillas urbanas en Lima, con pedido por WhatsApp. Demo de portafolio.',
  telephone: '+51900000000',
  priceRange: 'S/ 219 - S/ 429',
  openingHoursSpecification: { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'], opens: '10:00', closes: '19:00' },
  paymentAccepted: 'Yape, Plin, Contraentrega',
  currenciesAccepted: 'PEN',
  address: { '@type': 'PostalAddress', streetAddress: 'Av. Ejemplo 123 (ficticia)', addressLocality: 'Lima', addressCountry: 'PE' },
  areaServed: 'PE',
};
---
<Base
  titulo="Vértice Studio | Zapatillas urbanas en Lima, pedido por WhatsApp (demo)"
  descripcion="Catálogo ficticio de zapatillas running, urbanas, skate y básquet con filtro por talla, carrito y pedido por WhatsApp. Demo de portafolio de Vélez De Villa."
  ruta="/"
  jsonLd={[store]}
>
  <div class="marquee" data-marquee>
    <div class="marquee__pista" aria-hidden="true">
      {[0, 1].map(() => <ul>{marquee.map((m) => <li>{m}</li>)}</ul>)}
    </div>
    <p class="sr-only">{marquee.join('. ')}.</p>
    <button type="button" class="marquee__pausa" data-marquee-pausa aria-pressed="false" hidden>Pausar animación</button>
  </div>

  <section class="hero" aria-labelledby="hero-titulo">
    <div class="contenedor hero__grid">
      <div class="hero__texto">
        <p class="etiqueta">Lima · Pedido por WhatsApp</p>
        <h1 id="hero-titulo">Zapatillas <mark>sin</mark> rodeos.</h1>
        <p class="lead">Elige modelo y talla, arma tu carrito y envía el pedido por WhatsApp. No necesitas crear una cuenta.</p>
        <div class="hero__ctas">
          <a class="btn btn--primario" href="#catalogo">Ver catálogo <Icono nombre="abajo" /></a>
          <a class="btn" href="#como-comprar">Cómo comprar</a>
        </div>
      </div>
      <figure class="hero__visual">
        <Image
          src={foto(hero.foto)} alt={hero.alt} width={900} height={760} fit="cover" position="center" format="webp" quality={75}
          widths={[480, 720, 900]} sizes="(min-width: 900px) 46vw, 100vw"
          loading="eager" fetchpriority="high" decoding="async"
        />
        <figcaption>
          <a href={`/producto/${hero.slug}/`}><span>Destacado</span> {hero.nombre} · {formatoSoles(hero.precio)} <Icono nombre="flecha" tamano={18} /></a>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="seccion" id="catalogo" aria-labelledby="catalogo-titulo" data-catalogo>
    <div class="contenedor">
      <div class="seccion__cab">
        <h2 class="seccion__titulo" id="catalogo-titulo">Catálogo <mark>{productos.length}</mark></h2>
        <p class="lead">Precios en soles con IGV incluido. Stock por talla de demo, que se confirma por WhatsApp. Filtra y comparte el enlace.</p>
      </div>

      <div class="filtros" data-controles hidden>
        <fieldset class="filtros__grupo">
          <legend>Categoría</legend>
          <div class="opciones-filtro">
            <button type="button" class="chip" data-cat="" aria-pressed="true">Todas ({productos.length})</button>
            {CATEGORIAS.map((c) => <button type="button" class="chip" data-cat={c.id} aria-pressed="false">{c.nombre} ({cuenta(c.id)})</button>)}
          </div>
        </fieldset>
        <fieldset class="filtros__grupo">
          <legend>Talla EU</legend>
          <div class="opciones-filtro">
            <button type="button" class="chip chip--talla" data-talla="" aria-pressed="true">Todas</button>
            {TALLAS_EU.map((t) => <button type="button" class="chip chip--talla" data-talla={t} aria-pressed="false">{t}</button>)}
          </div>
        </fieldset>
        <div class="filtros__pie">
          <p class="filtros__estado" data-estado role="status" aria-live="polite">Mostrando {productos.length} de {productos.length} modelos.</p>
          <div class="filtros__acciones">
            <button type="button" class="btn-texto" data-limpiar>Limpiar filtros</button>
            <button type="button" class="btn-texto" data-copiar>Copiar enlace del filtro</button>
          </div>
          <p class="sr-only" data-copiado role="status" aria-live="polite"></p>
        </div>
      </div>

      <ul class="grilla" data-lista>
        {productos.map((p, i) => <TarjetaProducto producto={p} indice={i} />)}
      </ul>

      <div class="vacio-filtro" data-vacio-filtro hidden>
        <h3>Sin resultados</h3>
        <p>Ningún modelo tiene stock en esa combinación. Prueba otra talla u otra categoría.</p>
        <button type="button" class="btn btn--primario" data-limpiar>Limpiar filtros</button>
      </div>
    </div>
  </section>

  <section class="seccion seccion--negra" id="como-comprar" aria-labelledby="como-titulo">
    <div class="contenedor">
      <div class="seccion__cab">
        <h2 class="seccion__titulo" id="como-titulo">Cómo <mark>comprar</mark></h2>
        <p class="lead">Elige, arma y envía. Tú decides si lo envías.</p>
      </div>
      <ol class="pasos">
        <li>
          <h3>Elige</h3>
          <p><strong>Tu par.</strong> Filtra por categoría y talla. Abre la vista rápida para ver el modelo sin salir del catálogo.</p>
        </li>
        <li>
          <h3>Arma</h3>
          <p><strong>Tu carrito.</strong> Ajusta cantidades y elige Lima o provincias. El carrito se guarda en tu navegador.</p>
        </li>
        <li>
          <h3>Envía</h3>
          <p><strong>Por WhatsApp.</strong> Completas tus datos y se abre WhatsApp con el pedido escrito. Ahí se confirma el stock y se acuerda el pago (Yape, Plin o contraentrega).</p>
        </li>
      </ol>
      <div class="envios">
        <div class="envios__caja">
          <h3><Icono nombre="camion" tamano={26} /> Envíos</h3>
          <ul>
            <li>Lima Metropolitana: {formatoSoles(ENVIO.lima.tarifa)}. Gratis desde {formatoSoles(ENVIO.lima.gratisDesde)}.</li>
            <li>Provincias: {formatoSoles(ENVIO.provincias.tarifa)}. Gratis desde {formatoSoles(ENVIO.provincias.gratisDesde)}.</li>
          </ul>
        </div>
        <div class="envios__caja">
          <h3><Icono nombre="cambio" tamano={26} /> Cambios</h3>
          <ul>
            <li>Cambio de talla dentro de 7 días con el par sin uso.</li>
            <li><a href="/cambios/">Lee la política de cambios</a>.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="seccion seccion--naranja" id="tallas" aria-labelledby="tallas-titulo">
    <div class="contenedor tallas">
      <div>
        <h2 class="seccion__titulo" id="tallas-titulo">Mide tu <mark class="mark-negra">pie</mark></h2>
        <p class="lead">Mide tu pie y compara con la tabla. Las tallas de Vértice siguen la escala europea (EU). Cada modelo lista las tallas que tiene en stock. Las equivalencias pueden variar según el modelo.</p>
      </div>
      <TablaTallas />
    </div>
  </section>

  <VistaRapida />
  <script>
    import '../scripts/catalogo';

    const m = document.querySelector<HTMLElement>('[data-marquee]');
    const b = document.querySelector<HTMLButtonElement>('[data-marquee-pausa]');
    if (m && b) {
      b.hidden = false;
      b.addEventListener('click', () => {
        const pausado = m.classList.toggle('marquee--pausa');
        b.setAttribute('aria-pressed', String(pausado));
        b.textContent = pausado ? 'Reanudar animación' : 'Pausar animación';
      });
    }
  </script>
</Base>

<style>
  .marquee { position: relative; overflow: hidden; background: var(--negro); color: var(--blanco); border-bottom: var(--borde); }
  .marquee__pista { display: flex; width: max-content; animation: correr 38s linear infinite; }
  .marquee ul { display: flex; list-style: none; margin: 0; padding: 0; flex: none; }
  .marquee li { padding: 13px 22px; font-weight: 700; text-transform: uppercase; font-size: 12px; letter-spacing: 0.08em; white-space: nowrap; }
  .marquee li::after { content: '✱'; margin-left: 44px; color: var(--naranja); }
  .marquee--pausa .marquee__pista { animation-play-state: paused; }
  .marquee__pausa { position: absolute; right: 0; top: 0; bottom: 0; min-height: 44px; padding: 0 10px; border: 0; border-left: 3px solid var(--blanco); background: var(--naranja); color: var(--negro); font: 700 11px var(--fuente-texto); text-transform: uppercase; cursor: pointer; border-radius: 0; z-index: 1; }
  .marquee__pausa:hover { background: var(--blanco); }
  @keyframes correr { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .marquee { display: none; } }

  .hero { border-bottom: var(--borde); }
  .hero__grid { display: grid; gap: 14px; padding-block: 18px 22px; }
  .hero__texto { display: contents; }
  .hero__texto > .etiqueta { order: 1; justify-self: start; }
  .hero h1 { order: 2; font-size: clamp(60px, 17vw, 96px); line-height: 0.95; }
  .hero__visual { order: 3; }
  .hero__texto > .lead { order: 4; }
  .hero__ctas { order: 5; }
  .hero h1 mark { display: inline-block; line-height: 0.9; background: var(--naranja); color: var(--negro); padding: 0 0.1em; box-shadow: 6px 6px 0 var(--negro); }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: 14px; }
  .hero__visual { margin: 0 6px 0 0; position: relative; border: var(--borde); box-shadow: var(--sombra); background: var(--naranja); align-self: start; }
  .hero__visual :global(img) { width: 100%; height: 30svh; min-height: 150px; object-fit: cover; }
  .hero__visual figcaption { border-top: var(--borde); background: var(--blanco); }
  .hero__visual figcaption a { display: flex; align-items: center; gap: 8px; padding: 10px 14px; font-weight: 700; text-transform: uppercase; font-size: 13px; text-decoration: none; letter-spacing: 0.04em; }
  .hero__visual figcaption a span { background: var(--naranja); padding: 2px 8px; border: 2px solid var(--negro); }
  .hero__visual figcaption a:hover { background: var(--negro); color: var(--blanco); }
  @media (min-width: 700px) {
    .hero { min-height: calc(100svh - 143px); display: grid; align-items: center; }
    .hero__grid { grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); align-items: center; padding-block: 28px; gap: 20px 36px; }
    .hero__texto { display: flex; flex-direction: column; align-items: flex-start; gap: 16px; }
    .hero h1 { font-size: clamp(60px, 9.5vw, 128px); }
    .hero__visual :global(img) { height: auto; aspect-ratio: 900 / 760; max-height: calc(100svh - 280px); }
  }
  @media (min-width: 900px) { .hero { min-height: calc(100svh - 101px); } }
  @media (prefers-reduced-motion: no-preference) {
    .hero__texto > *, .hero__visual { animation: entra 0.6s cubic-bezier(0.22, 1, 0.36, 1) both; }
    .hero h1 { animation-delay: 0.05s; }
    .hero__texto > .lead { animation-delay: 0.15s; }
    .hero__ctas { animation-delay: 0.22s; }
    .hero__visual { animation-delay: 0.1s; }
  }
  @keyframes entra { from { opacity: 0.4; transform: translateY(14px); } to { opacity: 1; transform: none; } }

  .filtros { border: var(--borde); background: var(--blanco); box-shadow: var(--sombra-chica); margin-bottom: 24px; }
  .filtros__grupo { padding: 14px 14px 10px; border-bottom: var(--borde-fino); }
  .filtros__grupo legend { float: left; width: 100%; font-weight: 700; text-transform: uppercase; font-size: 12px; letter-spacing: 0.08em; margin-bottom: 8px; padding: 0; }
  .opciones-filtro { clear: both; display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { min-height: 44px; min-width: 44px; padding: 6px 14px; border: var(--borde); border-radius: 0; background: var(--blanco); color: var(--negro); font: 700 13px var(--fuente-texto); text-transform: uppercase; cursor: pointer; }
  .chip:hover { background: var(--naranja); }
  .chip[aria-pressed='true'] { background: var(--negro); color: var(--blanco); }
  .chip[aria-pressed='true']:hover { color: var(--naranja); }
  .chip--talla { padding-inline: 10px; }
  .filtros__pie { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 6px 16px; padding: 8px 14px; background: var(--gris); }
  .filtros__estado { margin: 0; font-weight: 700; font-size: 14px; }
  .filtros__acciones { display: flex; flex-wrap: wrap; gap: 4px 12px; }

  .grilla { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); border-top: var(--borde); border-left: var(--borde); background: var(--blanco); box-shadow: var(--sombra); margin-right: 6px; }
  @media (min-width: 700px) { .grilla { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 1100px) { .grilla { grid-template-columns: repeat(4, 1fr); } }
  .vacio-filtro { border: var(--borde); background: var(--blanco); padding: 32px 20px; text-align: center; box-shadow: var(--sombra); }
  .vacio-filtro h3 { font-size: 40px; margin-bottom: 10px; }

  .pasos { list-style: none; margin: 0 0 40px; padding: 0; display: grid; gap: 0; border: 3px solid var(--blanco); }
  .pasos li { padding: 22px 20px; border-bottom: 3px solid var(--blanco); }
  .pasos li:last-child { border-bottom: 0; }
  .pasos h3 { font-size: clamp(64px, 14vw, 120px); line-height: 0.9; margin: 0 0 12px; color: var(--naranja); }
  .pasos p { margin: 0; }
  @media (min-width: 800px) { .pasos { grid-template-columns: repeat(3, 1fr); } .pasos li { border-bottom: 0; border-right: 3px solid var(--blanco); } .pasos li:last-child { border-right: 0; } }
  .envios { display: grid; gap: 20px; }
  .envios__caja { background: var(--blanco); color: var(--negro); border: var(--borde); border-color: var(--naranja); padding: 20px; box-shadow: 6px 6px 0 var(--naranja); }
  .envios__caja h3 { display: flex; align-items: center; gap: 10px; font-size: 32px; margin-bottom: 10px; }
  .envios__caja ul { margin: 0; padding-left: 1.2em; }
  @media (min-width: 800px) { .envios { grid-template-columns: 1fr 1fr; } }

  .tallas { display: grid; gap: 28px; align-items: start; }
  .tallas :global(.guia-tallas) { max-width: 460px; }
  .tallas :global(.nota) { color: var(--negro); }
  .mark-negra { background: var(--negro) !important; color: var(--blanco) !important; }
  @media (min-width: 900px) { .tallas { grid-template-columns: 1.2fr 1fr; gap: 48px; } }
</style>
