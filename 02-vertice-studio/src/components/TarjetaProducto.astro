---
import { Image } from 'astro:assets';
import Icono from './Icono.astro';
import { foto } from '../data/fotos';
import { nombreCategoria, tallasDisponibles, type Producto } from '../data/productos';
import { formatoSoles } from '../lib/carrito';

interface Props { producto: Producto; prioridad?: boolean; indice: number }
const { producto: p, prioridad = false, indice } = Astro.props;
const tallas = tallasDisponibles(p);
const lista = tallas.join(' · ');
---
<li class="tarjeta" data-producto={p.slug} data-categoria={p.categoria} data-tallas={tallas.join(',')}>
  <a class="tarjeta__foto" href={`/producto/${p.slug}/`} tabindex="-1" aria-label={p.nombre}>
    <Image
      src={foto(p.foto)} alt="" width={640} height={800} fit="cover" position={p.posicion} format="webp" quality={72}
      sizes="(min-width: 1100px) 25vw, (min-width: 700px) 33vw, 50vw"
      widths={[320, 480, 640]}
      loading="lazy" decoding="async"
    />
    <span class="tarjeta__n" aria-hidden="true">{String(indice + 1).padStart(2, '0')}</span>
  </a>
  <div class="tarjeta__cuerpo">
    <p class="tarjeta__cat">{nombreCategoria(p.categoria)}</p>
    <h3 class="tarjeta__nombre"><a href={`/producto/${p.slug}/`}>{p.nombre}</a></h3>
    <p class="tarjeta__precio">{formatoSoles(p.precio)}</p>
    <p class="tarjeta__tallas" data-tallas-texto data-lista={lista}>Tallas EU: {lista}</p>
    <button type="button" class="btn tarjeta__vr" data-vista-rapida={p.slug} hidden>
      <Icono nombre="ojo" tamano={18} /> Ver<span class="sr-only"> vista rápida: {p.nombre}</span>
    </button>
  </div>
</li>

<style>
  .tarjeta { display: flex; flex-direction: column; background: var(--blanco); border-right: var(--borde); border-bottom: var(--borde); position: relative; }
  .tarjeta__foto { display: block; position: relative; border-bottom: var(--borde); background: var(--gris); overflow: hidden; }
  .tarjeta__foto :global(img) { width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; transition: transform 0.25s; }
  .tarjeta:hover .tarjeta__foto :global(img) { transform: scale(1.04); }
  .tarjeta__foto:hover { background: var(--gris); }
  .tarjeta__n { position: absolute; left: 0; top: 0; padding: 4px 10px; background: var(--negro); color: var(--blanco); font: 400 22px/1.1 var(--fuente-titulo); }
  .tarjeta__cuerpo { display: flex; flex-direction: column; gap: 2px; padding: 12px 12px 14px; flex: 1; }
  .tarjeta__cat { margin: 0; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; }
  .tarjeta__nombre { font-size: clamp(26px, 4.5vw, 34px); margin: 2px 0; }
  .tarjeta__nombre a { text-decoration: none; }
  .tarjeta__nombre a::after { content: none; }
  .tarjeta__nombre a:hover { background: var(--naranja); }
  .tarjeta__precio { margin: 0; font-weight: 700; font-size: 18px; }
  .tarjeta__tallas { margin: 0 0 10px; font-size: 13px; color: var(--negro); }
  .tarjeta__vr { margin-top: auto; width: 100%; min-height: 44px; padding: 8px 10px; font-size: 12px; }
  @media (prefers-reduced-motion: reduce) { .tarjeta__foto :global(img) { transition: none; } .tarjeta:hover .tarjeta__foto :global(img) { transform: none; } }
</style>
