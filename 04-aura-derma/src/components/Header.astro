---
import { NAV, NEGOCIO } from '../lib/negocio';
---

<header class="cab">
  <div class="contenedor cab__fila">
    <a class="marca" translate="no" href="/" aria-label={`${NEGOCIO.nombre}, inicio`}>Aura <em>Derma</em></a>

    <nav class="nav-desktop" aria-label="Principal">
      <ul>
        {NAV.map((n) => <li><a class="dibuja" href={n.href}>{n.texto}</a></li>)}
      </ul>
    </nav>

    <div class="cab__acciones">
      <a class="btn btn--chico" href="/#agenda">Reservar<span class="cab__cita">cita</span></a>
      <details class="menu-movil">
        <summary>Menú</summary>
        <nav aria-label="Principal móvil">
          <ul>
            {NAV.map((n) => <li><a href={n.href}>{n.texto}</a></li>)}
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .cab {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--porcelana);
    border-bottom: 1px solid var(--tinta);
  }
  .cab__fila {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: var(--alto-cab);
  }
  .marca {
    display: inline-flex;
    align-items: center;
    gap: 0.28em;
    min-height: 44px;
    color: var(--tinta);
    text-decoration: none;
    font: 400 1.65rem/1 var(--serif);
    letter-spacing: -0.02em;
  }
  .marca em {
    font-style: italic;
    color: var(--oxido);
  }
  .marca:hover {
    color: var(--tinta);
    text-decoration: none;
  }
  .nav-desktop {
    display: none;
  }
  .nav-desktop ul {
    display: flex;
    gap: 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-desktop a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--tinta);
    font-weight: 600;
    font-size: 0.92rem;
  }
  .cab__acciones {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .cab__cita {
    display: none;
  }
  .cab .btn {
    gap: 0.3em;
  }
  .menu-movil summary {
    list-style: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 72px;
    min-height: 44px;
    padding: 0 0.9rem;
    border: 1px solid var(--tinta);
    cursor: pointer;
    color: var(--tinta);
    font-weight: 600;
    font-size: 0.9rem;
    letter-spacing: 0.03em;
  }
  .menu-movil summary::-webkit-details-marker {
    display: none;
  }
  .menu-movil[open] summary {
    background: var(--tinta);
    color: var(--porcelana);
  }
  .menu-movil nav {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    background: var(--porcelana);
    border-bottom: 1px solid var(--tinta);
    padding: 0.5rem var(--gutter) 1rem;
  }
  .menu-movil ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .menu-movil li a {
    display: flex;
    align-items: center;
    min-height: 56px;
    width: 100%;
    border-bottom: 1px solid var(--linea);
    color: var(--tinta);
    text-decoration: none;
    font: 400 1.7rem/1.1 var(--serif);
  }
  .menu-movil li a:hover {
    color: var(--oxido);
  }
  @media (min-width: 62rem) {
    .nav-desktop {
      display: block;
    }
    .cab__cita {
      display: inline;
    }
    .menu-movil {
      display: none;
    }
    .cab__fila {
      min-height: 4.5rem;
    }
  }
</style>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('.menu-movil');
  if (menu) {
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) menu.open = false;
    });
    menu.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
  }
</script>
