---
import { ESPECIALISTAS, MENCION_REGISTRO } from '../lib/especialistas';

const [principal, ...otros] = ESPECIALISTAS;
---

<section class="seccion seccion--salvia" id="especialistas" aria-labelledby="esp-titulo">
  <div class="contenedor">
    <div class="seccion__cabecera">
      <p class="sobretitulo">Especialistas</p>
      <h2 id="esp-titulo">Quienes te atienden</h2>
      <p class="lead">Cuatro dermatólogos con enfoques distintos. Perfiles ficticios de demostración.</p>
      <p class="nota-sim">
        {MENCION_REGISTRO} En una clínica real se mostrarían el CMP y el RNE, verificables en el Colegio Médico del Perú.
      </p>
    </div>
    <div class="esp">
      <article class="esp__principal">
        <span class="esp__mono" aria-hidden="true">{principal.iniciales}</span>
        <div>
          <p class="esp__rol">Dirección clínica (perfil ficticio)</p>
          <h3>{principal.nombre}</h3>
          <p class="esp__enfoque">{principal.enfoque}</p>
          <p>{principal.detalle}</p>
        </div>
      </article>
      <ul class="esp__lista">
        {
          otros.map((e) => (
            <li>
              <span class="esp__ini" aria-hidden="true">{e.iniciales}</span>
              <div>
                <h3>{e.nombre}</h3>
                <p class="esp__enfoque">{e.enfoque}</p>
                <p>{e.detalle}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .esp {
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 62rem) {
    .esp {
      grid-template-columns: 1.05fr 1fr;
      gap: 3rem;
      align-items: start;
    }
  }
  .esp__principal {
    background: var(--salvia-900);
    color: #eef2ea;
    border-radius: var(--radio-lg);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    display: grid;
    gap: 1.25rem;
  }
  .esp__principal h3 {
    color: #ffffff;
    font-size: 2rem;
  }
  .esp__principal .esp__enfoque {
    color: var(--salvia-100);
  }
  .esp__mono {
    font: 400 4.5rem/1 var(--serif);
    color: var(--salvia-300);
  }
  .esp__rol {
    font-size: 0.8125rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--salvia-300);
    margin-bottom: 0.5rem;
  }
  .esp__enfoque {
    color: var(--salvia-700);
    font-weight: 600;
    margin-bottom: 0.5rem;
  }
  .esp__lista {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .esp__lista li {
    display: flex;
    gap: 1rem;
    padding-block: 1.25rem;
    border-top: 1px solid var(--salvia-500);
  }
  .esp__lista li:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .esp__ini {
    flex: none;
    font: 400 1.9rem/1 var(--serif);
    color: var(--salvia-700);
    width: 3rem;
  }
  .esp__lista h3 {
    margin-bottom: 0.1rem;
  }
  .esp__lista p {
    margin-bottom: 0.4rem;
  }
</style>
