---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { NEGOCIO } from '../lib/negocio';
import { TRATAMIENTOS, formatoPEN } from '../lib/tratamientos';
import { ESPECIALISTAS } from '../lib/especialistas';
import foto from '../assets/fotos/pexels-7446684.jpg';

const consulta = TRATAMIENTOS.find((t) => t.id === 'consulta')!;
const precio = formatoPEN.format(consulta.desde).replace(/\s+/g, ' ');
---

<section class="hero" aria-labelledby="hero-titulo">
  <div class="hero__texto">
    <p class="sobretitulo hero__linea">Dermatología · San Isidro, Lima</p>
    <h1 id="hero-titulo">Tu piel, <em>leída con calma</em> por un especialista.</h1>
    <p class="lead">
      Primero te escuchamos y examinamos tu piel; después te explicamos las opciones, sin apuros y sin prometer resultados.
    </p>
    <div class="hero__acciones">
      <a class="btn" href="#agenda"><Icon name="calendar-days" /> Reservar una cita</a>
      <a class="dibuja hero__enlace" href="#tratamientos">Comparar tratamientos</a>
    </div>
    <dl class="hero__datos">
      <div>
        <dt>Primera consulta</dt>
        <dd>30–40 <span>min</span></dd>
      </div>
      <div>
        <dt>Especialistas</dt>
        <dd>{ESPECIALISTAS.length}</dd>
      </div>
      <div>
        <dt>Referencial, con IGV</dt>
        <dd>{precio}</dd>
      </div>
    </dl>
    <p class="hero__pie">
      <span>Lunes a sábado</span>
      <a class="dibuja" href={`https://wa.me/${NEGOCIO.whatsapp}`} rel="noopener">WhatsApp de demo<span class="visually-hidden">, se abre en otra pestaña o aplicación</span></a>
    </p>
  </div>
  <figure class="hero__foto">
    <Image
      src={foto}
      alt="Una dermatóloga con mascarilla y guantes muestra una tableta a una paciente sonriente, en un consultorio blanco y luminoso."
      widths={[480, 720, 960, 1280, 1600]}
      sizes="(min-width: 62rem) 48vw, 100vw"
      format="webp"
      quality={74}
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </figure>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    background: var(--porcelana);
    border-bottom: 1px solid var(--tinta);
  }
  .hero__texto {
    padding: clamp(2rem, 6vw, 3.5rem) var(--gutter) clamp(2rem, 6vw, 3.5rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .hero__linea {
    margin-bottom: 1.25rem;
  }
  .hero h1 {
    margin-bottom: 0.4em;
    animation: sube 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  .hero .lead {
    max-width: 32rem;
  }
  .hero__acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 2rem;
    margin: 1.5rem 0 2rem;
  }
  .hero__enlace {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
    color: var(--tinta);
    background-size: 100% 1px;
  }
  .hero__enlace:hover {
    background-size: 100% 2px;
  }
  .hero__datos {
    display: grid;
    grid-template-columns: repeat(3, auto);
    justify-content: start;
    gap: 0 clamp(1rem, 4vw, 3rem);
    margin: 0 0 1.25rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--tinta);
    max-width: 36rem;
  }
  .hero__datos dt {
    font-size: 0.8125rem;
    color: var(--tinta-suave);
    line-height: 1.3;
  }
  .hero__datos dd {
    margin: 0.2rem 0 0;
    font: 400 clamp(1.6rem, 4.2vw, 2.7rem) / 1 var(--serif);
    color: var(--tinta);
    white-space: nowrap;
  }
  .hero__datos dd span {
    font: italic 400 1rem var(--serif);
    color: var(--oxido-osc);
  }
  .hero__pie {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 1.5rem;
    margin: 0;
    font-size: 0.9rem;
    color: var(--tinta-suave);
  }
  .hero__pie span {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .hero__pie a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--tinta);
    font-weight: 600;
  }
  .hero__foto {
    margin: 0;
    position: relative;
    min-height: 18rem;
    overflow: hidden;
    border-top: 1px solid var(--tinta);
    animation: revela 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  .hero__foto :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 40%;
  }
  @media (min-width: 62rem) {
    .hero {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
      min-height: calc(100svh - 7rem);
      min-height: calc(100svh - 7.5rem);
    }
    .hero__texto {
      padding-left: max(var(--gutter), calc((100vw - var(--ancho)) / 2));
      padding-right: clamp(2rem, 4vw, 4rem);
    }
    .hero__foto {
      border-top: 0;
      border-left: 1px solid var(--tinta);
      min-height: 0;
    }
    .hero__foto :global(img) {
      object-position: 55% 30%;
    }
  }
  @keyframes sube {
    from {
      transform: translateY(0.5rem);
    }
  }
  @keyframes revela {
    from {
      clip-path: inset(0 0 0 100%);
    }
  }
</style>
