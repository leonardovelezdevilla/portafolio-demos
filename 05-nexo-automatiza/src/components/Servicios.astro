---
import Icon from './Icon.astro';
import { SERVICIOS } from '../data/contenido';
---
<section class="seccion servicios" id="servicios" aria-labelledby="h-serv">
  <div class="wrap">
    <div class="servicios__cab">
      <h2 class="h2" id="h-serv" data-reveal data-delay="1">Cinco frentes donde las pymes pierden horas</h2>
    </div>
    <ul class="servicios__lista">
      {SERVICIOS.map((s, i) => (
        <li class={`serv serv--${i + 1}`} data-reveal={i % 2 ? 'der' : 'izq'}>
          <Icon nombre={s.icono as any} tamano={32} />
          <h3>{s.titulo}</h3>
          <p>{s.texto}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .servicios__cab { margin-bottom: 48px; }
  .servicios__cab h2 { max-width: 20ch; }
  @media (min-width: 900px) { .servicios__cab { margin-left: 8.33%; } .servicios__cab h2 { max-width: 22ch; } }
  .servicios__lista { display: grid; gap: 20px; }
  .serv { background: var(--paper-2); border: 2px solid var(--ink); padding: 28px 24px; border-radius: 4px; display: grid; gap: 12px; align-content: start; }
  .serv h3 { font-size: 1.15rem; line-height: 1.2; }
  .serv--2 { background: var(--lima); }
  .serv--4 { background: var(--ink); color: var(--paper); }
  .serv--4 .icono { color: var(--lima); }
  @media (min-width: 640px) {
    .servicios__lista { grid-template-columns: repeat(2, 1fr); }
    .serv--1 { margin-right: 24px; }
    .serv--2 { margin-top: 40px; }
    .serv--3 { margin-left: 24px; }
    .serv--4 { margin-top: 24px; }
  }
  @media (min-width: 1000px) {
    .servicios__lista { grid-template-columns: repeat(6, 1fr); gap: 24px; }
    .serv--1 { grid-column: 1 / 3; margin: 0; }
    .serv--2 { grid-column: 3 / 5; margin-top: 56px; }
    .serv--3 { grid-column: 5 / 7; margin: 28px 0 0; }
    .serv--4 { grid-column: 2 / 4; margin: -8px 0 0; }
    .serv--5 { grid-column: 4 / 7; margin-top: 32px; }
  }
  .serv--5 { background: var(--paper); }
</style>
