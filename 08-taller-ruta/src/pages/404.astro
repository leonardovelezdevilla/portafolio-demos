  <section class="legal">
    <div class="wrap legal__in">
      <h1>Esta ruta no existe</h1>
      <p>Tomaste un desvío: la página que buscas no está en esta demo.</p>
      <p><a class="btn" href="/">Volver al inicio</a></p>
    </div>
  </section>
</Base>
