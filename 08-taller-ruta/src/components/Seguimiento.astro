---
import { SEGUIMIENTOS } from '../data/seguimiento';
import Icon from './Icon.astro';
---
<section class="seccion seccion--papel" id="seguimiento" aria-labelledby="t-seg">
  <div class="wrap seg">
    <div class="seg__lado">
      <p class="etiqueta">Seguimiento de tu vehículo</p>
      <h2 id="t-seg">Sin llamadas para saber cómo va</h2>
      <p class="intro">Con el código que te damos al recibir tu vehículo ves en qué etapa está. Prueba con un código de ejemplo.</p>
      <p class="aviso"><span class="chip-demo">Ejemplo de demo</span> Estos códigos no corresponden a vehículos reales: son para mostrar cómo se vería el seguimiento. El código te lo entregamos al recibir tu vehículo en el taller. En un taller real se pediría además tu DNI o celular, y la placa se mostraría oculta en parte, como aquí.</p>
    </div>

    <div class="seg__cuerpo">
      <form id="seg-form" novalidate method="post" action="/404/" class="seg__form" aria-label="Buscar seguimiento">
        <div class="campo">
          <label for="seg-codigo">Código de seguimiento</label>
          <p class="ayuda" id="seg-ayuda">Ejemplo: TR-DEMO-1002</p>
          <div class="seg__fila">
            <input id="seg-codigo" name="codigo" autocomplete="off" aria-describedby="seg-ayuda e-seg" />
            <button class="btn btn--oscuro" type="submit"><Icon nombre="buscar" tamano={20} /> Ver estado</button>
          </div>
          <p class="err" id="e-seg" role="alert"></p>
        </div>
        <p class="ayuda">O prueba con:</p>
        <ul class="seg__ejemplos">
          {SEGUIMIENTOS.map((s) => (
            <li><button type="button" class="btn btn--borde seg__ej" data-codigo={s.codigo}>{s.codigo}</button></li>
          ))}
        </ul>
      </form>

      <div id="seg-res" class="seg__res" hidden>
        <h3 tabindex="-1" id="seg-titulo"></h3>
        <p class="muted" id="seg-meta"></p>
        <ol class="linea" id="seg-linea"></ol>
        <p class="aviso" id="seg-nota"></p>
      </div>
    </div>
  </div>
</section>

<script>
  import { ETAPAS } from '../data/seguimiento';
  import { buscarSeguimiento, esCodigoDeCita, ocultarPlaca } from '../lib/seguimiento';

  const form = document.getElementById('seg-form') as HTMLFormElement;
  const input = document.getElementById('seg-codigo') as HTMLInputElement;
  const err = document.getElementById('e-seg')!;
  const res = document.getElementById('seg-res')!;

  function mostrar(codigo: string) {
    const s = buscarSeguimiento(codigo);
    if (!s) {
      err.textContent = esCodigoDeCita(codigo)
        ? 'Aún no recibimos tu vehículo: el código de seguimiento (TR-DEMO-…) se entrega en el taller al recibirlo.'
        : 'No encontramos ese código. Revisa que diga TR-DEMO seguido de 4 números o usa uno de los ejemplos.';
      input.setAttribute('aria-invalid', 'true');
      res.hidden = true;
      input.focus();
      return;
    }
    err.textContent = '';
    input.removeAttribute('aria-invalid');
    input.value = s.codigo;
    const titulo = document.getElementById('seg-titulo')!;
    titulo.textContent = `Estado: ${ETAPAS[s.etapa].nombre}`;
    document.getElementById('seg-meta')!.textContent = `${s.codigo}. ${s.vehiculo}, placa ${ocultarPlaca(s.placa)}. Servicio: ${s.servicio}.`;
    document.getElementById('seg-linea')!.replaceChildren(
      ...ETAPAS.map((e, i) => {
        const li = document.createElement('li');
        const estado = i < s.etapa ? 'hecho' : i === s.etapa ? 'actual' : 'pendiente';
        li.className = estado;
        if (estado === 'actual') li.setAttribute('aria-current', 'step');
        const marca = document.createElement('span');
        marca.className = 'marca-etapa';
        marca.textContent = estado === 'hecho' ? '✓' : String(i + 1);
        marca.setAttribute('aria-hidden', 'true');
        const t = document.createElement('div');
        const n = document.createElement('strong');
        n.textContent = e.nombre;
        const etiqueta = document.createElement('span');
        etiqueta.className = 'estado-txt';
        etiqueta.textContent = estado === 'hecho' ? 'Completada' : estado === 'actual' ? 'En esta etapa' : 'Pendiente';
        const d = document.createElement('p');
        d.textContent = e.detalle;
        t.append(n, ' ', etiqueta, d);
        li.append(marca, t);
        return li;
      }),
    );
    document.getElementById('seg-nota')!.textContent = s.nota;
    res.hidden = false;
    titulo.focus();
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!input.value.trim()) {
      err.textContent = 'Escribe un código de seguimiento.';
      input.setAttribute('aria-invalid', 'true');
      input.focus();
      return;
    }
    mostrar(input.value);
  });
  document.querySelectorAll<HTMLButtonElement>('.seg__ej').forEach((b) => b.addEventListener('click', () => mostrar(b.dataset.codigo!)));
  input.addEventListener('input', () => {
    err.textContent = '';
    input.removeAttribute('aria-invalid');
  });
</script>

<style is:global>
  .seg { display: grid; gap: 40px; }
  @media (min-width: 960px) { .seg { grid-template-columns: 0.8fr 1.2fr; gap: 64px; align-items: start; } }
  .seg__fila { display: grid; gap: 10px; }
  @media (min-width: 520px) { .seg__fila { grid-template-columns: 1fr auto; } }
  .seg__ejemplos { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 8px; }
  .seg__ej { font-size: 0.95rem; padding-inline: 14px; }
  .seg__res { margin-top: 28px; border-top: 3px solid var(--asfalto); padding-top: 20px; }
  .seg__res h3 { font-size: 2.1rem; }
  .linea { display: grid; gap: 0; margin: 20px 0; }
  .linea li { display: grid; grid-template-columns: 40px 1fr; gap: 14px; padding-bottom: 20px; position: relative; }
  .linea li:not(:last-child)::before { content: ''; position: absolute; left: 19px; top: 40px; bottom: 0; border-left: 3px solid var(--linea); }
  .linea li.hecho:not(:last-child)::before { border-left-color: var(--asfalto); }
  .linea p { margin: 2px 0 0; color: var(--texto-suave); font-size: 0.97rem; }
  .marca-etapa { display: grid; place-items: center; width: 40px; height: 40px; border: 3px solid var(--linea); border-radius: 50%; font-family: var(--f-titular); font-weight: 700; font-size: 1.2rem; background: #fff; color: var(--texto-suave); }
  .hecho .marca-etapa { background: var(--asfalto); border-color: var(--asfalto); color: #fff; }
  .actual .marca-etapa { background: var(--senal); border-color: var(--asfalto); color: var(--asfalto); }
  .estado-txt { display: inline-block; font-size: 0.8rem; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--texto-suave); }
  .actual .estado-txt { color: var(--asfalto); background: var(--senal); padding: 0 6px; border-radius: 2px; }
</style>
