---
import { WA_BASE } from '../data/taller';
import Icon from './Icon.astro';
---
<header class="cab oscuro">
  <div class="wrap cab__in">
    <a class="cab__logo" href="/" aria-label="Taller Ruta, inicio">
      <span class="cab__sello" aria-hidden="true">TR</span>
      <span class="cab__nombre">Taller Ruta</span>
    </a>
    <nav aria-label="Principal" class="cab__nav-wrap">
      <ul class="cab__nav">
        <li><a href="/#cotizador">Cotizar</a></li>
        <li><a href="/#reserva">Reservar</a></li>
        <li><a href="/#seguimiento">Seguimiento</a></li>
        <li class="solo-ancho"><a href="/#garantias">Garantías</a></li>
        <li class="solo-ancho"><a href="/#preguntas">Preguntas</a></li>
      </ul>
    </nav>
    <a class="cab__wa" href={WA_BASE}><Icon nombre="mensaje" tamano={20} /> <span>WhatsApp</span></a>
  </div>
</header>

<style>
  .cab { background: var(--asfalto); color: #fff; border-bottom: 1px solid var(--linea-oscura); }
  .cab__in { display: flex; align-items: center; justify-content: space-between; gap: 16px; height: var(--cab); box-sizing: border-box; }
  .cab__logo { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; min-height: 44px; white-space: nowrap; flex: none; }
  .cab__sello { display: grid; place-items: center; width: 36px; height: 32px; border: 2px solid #fff; font-family: var(--f-mono); font-weight: 500; font-size: 0.95rem; letter-spacing: -0.02em; line-height: 1; border-radius: 2px; }
  .cab__nombre { font-family: var(--f-titular); font-weight: 800; font-size: 1.65rem; letter-spacing: 0.05em; text-transform: uppercase; line-height: 1; }
  .cab__nav-wrap { display: none; margin-left: auto; }
  .cab__nav { display: flex; gap: 0 2px; }
  .cab__nav a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 12px; text-decoration: none; font-weight: 600; font-size: 0.96rem; background: linear-gradient(currentColor, currentColor) 12px calc(50% + 12px) / 0 2px no-repeat; transition: background-size 0.2s; }
  .cab__nav a:hover { background-size: calc(100% - 24px) 2px; }
  .cab__wa { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 14px; background: var(--senal); color: var(--asfalto); font-weight: 600; text-decoration: none; border-radius: 2px; white-space: nowrap; }
  .cab__wa:hover { background: #ffc61f; }
  .solo-ancho { display: none; }
  @media (min-width: 720px) { .cab__nav-wrap { display: block; } }
  @media (min-width: 1040px) { .solo-ancho { display: block; } }
</style>
