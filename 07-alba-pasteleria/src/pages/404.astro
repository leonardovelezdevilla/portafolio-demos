---
import Base from '../layouts/Base.astro';
---
<Base titulo="Página no encontrada | Alba Pastelería (demo)" descripcion="La página que buscas no existe en esta demo de Alba Pastelería." ruta="/404/" sinCanonical>
  <section class="contenedor seccion">
    <p class="etiqueta">Error 404</p>
    <h1>Esta página se quedó sin horno.</h1>
    <p class="lead">No encontramos lo que buscas. Vuelve al inicio y arma tu torta.</p>
    <p><a class="btn btn--primario" href="/">Ir al inicio</a></p>
  </section>
</Base>
