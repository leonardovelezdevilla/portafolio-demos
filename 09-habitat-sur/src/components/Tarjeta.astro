---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { FOTOS } from '../data/fotos';
import { TIPO_CAMBIO, type Departamento } from '../data/departamentos';
import { soles, dolares } from '../lib/formato';
interface Props { d: Departamento; eager?: boolean; nivel?: 2 | 3; }
const { d, eager = false, nivel = 3 } = Astro.props;
const H = `h${nivel}` as 'h2' | 'h3';
const foto = FOTOS[d.fotos[0]];
const tc = String(TIPO_CAMBIO).replace('.', ',');
---
<article class="tarjeta" data-slug={d.slug}>
  <div class="t-foto">
    <Image src={foto.src} alt="" width={640} height={800} format="webp" quality={72} widths={[360, 640]} sizes="(min-width: 1100px) 400px, (min-width: 700px) 45vw, 100vw" loading={eager ? 'eager' : 'lazy'} decoding="async" />
    <span class={`t-etapa e-${d.etapa.replace(/\s/g, '-')}`}>{d.etapa[0].toUpperCase() + d.etapa.slice(1)}</span>
    <span class="t-sello">Foto referencial</span>
  </div>
  <div class="t-cuerpo">
    <p class="t-lugar">{d.distrito} · {d.proyecto}</p>
    <H><a href={`/departamento/${d.slug}/`}>{d.nombre}<span class="sr-only">, {d.dormitorios} {d.dormitorios === 1 ? 'dormitorio' : 'dormitorios'}, {d.area} metros cuadrados</span></a></H>
    <ul class="t-datos" aria-label="Características">
      <li><Icon name="bed-double" size={18} /> {d.dormitorios} {d.dormitorios === 1 ? 'dormitorio' : 'dormitorios'}</li>
      <li><Icon name="bath" size={18} /> {d.banos} {d.banos === 1 ? 'baño' : 'baños'}</li>
      <li><Icon name="ruler" size={18} /> {d.area} m²</li>
      <li><Icon name="building-2" size={18} /> Piso {d.piso}</li>
    </ul>
    <p class="t-precio"><strong>{soles(d.precio)}</strong> <span>ref. {dolares(d.precio)} (TC demo {tc})</span></p>
  </div>
</article>
<style>
  .tarjeta { position: relative; display: grid; grid-template-rows: auto 1fr; height: 100%; background: var(--blanco); border: 1px solid var(--tinta); transition: transform .2s ease; }
  .tarjeta:hover { transform: translateY(-2px); }
  .t-foto { position: relative; aspect-ratio: 5 / 4; overflow: hidden; background: var(--papel-2); border-bottom: 1px solid var(--tinta); }
  .t-foto img { width: 100%; height: 100%; object-fit: cover; transition: transform .35s ease; }
  .tarjeta:hover .t-foto img { transform: scale(1.02); }
  .t-etapa { position: absolute; left: 0; top: 0; padding: .45rem .8rem; font: 600 .8rem/1 var(--f-cuerpo); background: var(--tinta); color: var(--papel); }
  .e-entrega-inmediata { background: var(--sol-osc); color: #fff; }
  .t-sello { position: absolute; right: 0; bottom: 0; padding: .35rem .65rem; font: 400 .75rem/1.1 var(--f-cuerpo); background: var(--papel); color: var(--tinta); }
  .t-cuerpo { padding: 1.15rem 1.3rem 1.4rem; display: grid; gap: .45rem; align-content: start; }
  .t-lugar { margin: 0; color: var(--tinta-2); font-size: .9rem; }
  .t-cuerpo :global(h2), .t-cuerpo :global(h3) { margin: 0; font-size: 1.9rem; line-height: 1.2; }
  .t-cuerpo :global(a) { display: inline-block; min-height: 44px; padding-block: .35rem; color: var(--tinta); text-decoration: none; background: linear-gradient(var(--sol), var(--sol)) 0 100% / 0 2px no-repeat; transition: background-size .25s ease; }
  .t-cuerpo :global(a)::after { content: ''; position: absolute; inset: 0; }
  .tarjeta:hover .t-cuerpo :global(a) { background-size: 100% 2px; }
  .t-datos { list-style: none; margin: .2rem 0; padding: 0; display: flex; flex-wrap: wrap; gap: .3rem 1rem; font-size: .9rem; }
  .t-datos li { display: inline-flex; align-items: center; gap: .35rem; }
  .t-precio { margin: .4rem 0 0; display: grid; padding-top: .8rem; border-top: 1px solid var(--linea); }
  .t-precio strong { font: 400 2rem/1.1 var(--f-titulo); }
  .t-precio span { font-size: .82rem; color: var(--tinta-2); }
</style>
