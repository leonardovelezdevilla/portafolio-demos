---
// Plano esquemático propio, generado a partir de los datos. No está a escala ni es un plano de venta.
interface Props { dormitorios: number; banos: number; area: number; id?: string; titulo?: string; pie?: boolean; }
const { dormitorios, banos, area, id = 'plano', titulo = 'Plano esquemático del departamento', pie = true } = Astro.props;
type Sala = { n: string; k: 'sala' | 'cocina' | 'dorm' | 'bano'; x: number; y: number; w: number; h: number };
const X0 = 24, Y0 = 24, W = 352, H = 250, ALTO_SUP = 118;
const salas: Sala[] = [
  { n: 'Sala-comedor', k: 'sala', x: X0, y: Y0, w: 208, h: ALTO_SUP },
  { n: 'Cocina', k: 'cocina', x: X0 + 208, y: Y0, w: W - 208, h: ALTO_SUP },
];
const banoW = 84;
const dormW = (W - banoW) / dormitorios;
const yb = Y0 + ALTO_SUP, hb = H - ALTO_SUP;
for (let i = 0; i < dormitorios; i++) salas.push({ n: dormitorios === 1 ? 'Dormitorio' : `Dorm. ${i + 1}`, k: 'dorm', x: X0 + i * dormW, y: yb, w: dormW, h: hb });
for (let i = 0; i < banos; i++) salas.push({ n: banos === 1 ? 'Baño' : `Baño ${i + 1}`, k: 'bano', x: X0 + W - banoW, y: yb + (i * hb) / banos, w: banoW, h: hb / banos });
const lista = salas.map((s) => s.n).join(', ');
const dormitoriosSalas = salas.filter((s) => s.k === 'dorm');
const t = `${id}-t`, d = `${id}-d`;
---
<figure class="plano">
  <svg viewBox="0 0 400 318" role="img" aria-labelledby={`${t} ${d}`} focusable="false">
    <title id={t}>{titulo}</title>
    <desc id={d}>Esquema no a escala con {lista}. Área techada de {area} metros cuadrados.</desc>
    <g class="trama" aria-hidden="true">
      {[...Array(9)].map((_, i) => <line x1={X0 + i * 44} y1="8" x2={X0 + i * 44} y2="276" />)}
    </g>
    {salas.map((s) => (
      <g>
        <rect class={`s-${s.k}`} x={s.x} y={s.y} width={s.w} height={s.h} />
        <text class="rot" x={s.x + s.w / 2} y={s.y + s.h / 2 + 4} text-anchor="middle">{s.n}</text>
      </g>
    ))}
    <rect class="muro" x={X0} y={Y0} width={W} height={H} />
    <!-- puertas: vano y hoja -->
    <g aria-hidden="true">
      <rect class="vano" x={X0 + 120} y={Y0 + ALTO_SUP - 2} width="34" height="4" />
      <path class="hoja" d={`M${X0 + 120} ${Y0 + ALTO_SUP} v34 a34 34 0 0 0 34 -34`} />
      {dormitoriosSalas.map((s) => (
        <g>
          <rect class="vano" x={s.x + s.w / 2 - 14} y={yb - 2} width="28" height="4" />
          <path class="hoja" d={`M${s.x + s.w / 2 - 14} ${yb} v28 a28 28 0 0 1 28 -28`} />
        </g>
      ))}
      <rect class="vano" x={X0 + 40} y={Y0 - 2} width="120" height="4" />
      <rect class="vano" x={X0 + 40} y={Y0 + H - 2} width="60" height="4" />
    </g>
    <g class="cota" aria-hidden="true">
      <path d={`M${X0} 296h${W}M${X0} 290v12M${X0 + W} 290v12`} />
      <text x={X0 + W / 2} y="313" text-anchor="middle">{area} m² techados (esquema)</text>
    </g>
  </svg>
  {pie && <figcaption>Distribución tipo de ejemplo, no a escala. Los ambientes pueden variar en el plano final de la promotora.</figcaption>}
</figure>
<style>
  .plano { margin: 0; background: var(--tinta); color: var(--papel); padding: clamp(.8rem, 2.5vw, 1.4rem); }
  svg { width: 100%; height: auto; display: block; }
  .trama line { stroke: #2d3b47; stroke-width: 1; }
  .muro { fill: none; stroke: var(--papel); stroke-width: 5; }
  rect[class^='s-'] { stroke: var(--papel); stroke-width: 1.6; }
  .s-sala { fill: #1f2e3a; }
  .s-cocina { fill: #263644; }
  .s-dorm { fill: #1f2e3a; }
  .s-bano { fill: #2f4251; }
  .rot { font: 600 15px var(--f-cuerpo); fill: var(--papel); letter-spacing: .02em; }
  .vano { fill: var(--tinta); }
  .hoja { fill: none; stroke: var(--sol-claro); stroke-width: 1.4; stroke-dasharray: 3 3; }
  .cota path { stroke: var(--sol-claro); stroke-width: 1.5; fill: none; }
  .cota text { font: 600 13px var(--f-cuerpo); fill: var(--sol-claro); }
  figcaption { font-size: .85rem; color: #c9ced2; margin-top: .6rem; }
</style>
