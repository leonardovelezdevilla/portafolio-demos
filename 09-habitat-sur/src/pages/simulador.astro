---
import Base from '../layouts/Base.astro';
import Simulador from '../components/Simulador.astro';
---
<Base titulo="Simulador de crédito hipotecario · Habitat Sur" descripcion="Calcula una cuota mensual referencial por método francés con una TEA editable. No es una oferta ni reemplaza la evaluación de una entidad financiera." ruta="/simulador/">
  <div class="contenedor seccion">
    <p class="sobretitulo">Herramienta referencial</p>
    <Simulador selector precio={450000} id="sim" nivel={1} />
  </div>
</Base>
